{
  "manifest_version": 3,
  "name": "Xtend Capture",
  "version": "0.7.0",
  "description": "Forwards what x.com already loaded while you browse to Xtend. Sends no requests to X.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "cookies", "identity"],
  "host_permissions": ["https://x.com/*", "https://xtend.example.com/*", "https://xtend.localhost/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://x.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://x.com/*"], "js": ["bridge.js"], "run_at": "document_start" },
    { "matches": ["https://xtend.example.com/*", "https://xtend.localhost/*"], "js": ["xtend.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Xtend", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "web_accessible_resources": [{ "resources": ["icons/icon-32.png"], "matches": ["https://x.com/*"] }],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
