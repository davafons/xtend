<%# Collapses to icons below 1280px and wherever you collapsed it; the choice is kept in a cookie. %>
<% connection = X::Connection.current unless demo? %>
<% handle = Current.user&.x_handle %>
<%= lc_sidebar cookie: "sidebar", class: "xtend-sidebar" do |sidebar| %>
  <%= sidebar.header do %>
    <%= link_to root_path, class: "flex items-center gap-related", aria: { label: "xtend" } do %>
      <%= image_tag "/icon.png", alt: "", class: "size-8 shrink-0" %>
      <span class="xtend-signature-text text-subheading font-bold lc-rail:hidden" aria-hidden="true">xtend</span>
    <% end %>
  <% end %>
  <%= lc_search label: "Search and commands", src: search_path, trigger: "Search", placeholder: "Search people, tags, drafts, posts, or pages…", empty: "Nothing matches %{query}", class: "w-full lc-rail:hidden" do %>
    <%= render "searches/results", search: Search.new(nil) %>
  <% end %>
  <%= sidebar.body class: "overflow-y-auto" do %>
    <%= lc_nav_list label: "Main" do |nav| %>
      <% navigation_sections.each do |heading, items| %>
        <%= nav.group heading do %>
          <% items.each do |label, path, icon| %>
            <%= nav.link label, path, icon: icon, current: navigation_active?(path), title: label %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= sidebar.footer class: "border-t border-border pt-related" do %>
    <% unless demo? %>
      <% workspace = Current.workspace %>
      <div data-controller="live" data-live-url-value="<%= x_capture_status_path %>" data-live-captured-at-value="<%= workspace.captured_at&.iso8601(3) %>">
      <%= lc_card href: x_capture_status_path, padding: :sm, class: "lc-rail:bg-transparent lc-rail:p-0",
            title: "Extension status: #{capture_summary(workspace.last_capture) || "nothing from the extension yet"}", data: { live_target: "status" } do %>
      <span class="flex items-center gap-related lc-rail:justify-center">
        <span class="flex w-6.5 shrink-0 justify-center" aria-hidden="true">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full rounded-full bg-ai opacity-0" data-live-target="ping"></span>
            <span class="relative inline-flex size-2 rounded-full <%= workspace.captured_at && workspace.captured_at > 10.minutes.ago ? "bg-ai" : "bg-muted-foreground" %>" data-live-target="dot"></span>
          </span>
        </span>
        <span class="min-w-0 grow lc-rail:sr-only" role="status">
          <span class="flex items-baseline justify-between gap-related text-caption">
            <span class="font-medium">Extension</span>
            <time class="shrink-0 text-muted-foreground" data-live-target="time" datetime="<%= workspace.captured_at&.iso8601 %>"><%= workspace.captured_at ? "#{time_ago_in_words(workspace.captured_at)} ago" : "nothing yet" %></time>
          </span>
          <span class="block truncate text-caption text-muted-foreground" data-live-target="summary"><%= capture_summary(workspace.last_capture) || "Nothing captured yet" %></span>
        </span>
        <%= lc_icon "chevron-right", options: { class: "size-4 shrink-0 text-muted-foreground lc-rail:hidden", "aria-hidden": true } %>
      </span>
      <% end %>
      <template data-live-target="notice">
        <%= lc_toast tone: :primary, timeout: 0, data: { live_notice: true } do %>New data from x.com <%= lc_button_link_to "Refresh", request.fullpath, size: :sm, variant: :secondary, data: { turbo_action: "replace" } %><% end %>
      </template>
      </div>
    <% end %>
    <%= sidebar.account "@#{handle}", detail: (connection ? "X connected" : (demo? ? "Demo data" : "X not connected")),
          avatar: (connection ? owner_avatar(size: :sm) : lc_icon("signal-slash", options: { class: "size-4 text-muted-foreground", "aria-hidden": true })), id: "account-menu" do %>
      <% unless demo? %><%= lc_menu_option "Your profile on X", icon: "arrow-up-right", href: "https://x.com/#{handle}", target: "_blank", rel: "noopener noreferrer" %><% end %>
      <%= lc_menu_option "Settings", icon: "cog-6-tooth", href: settings_path %>
      <% other = (User::THEMES - [ Current.user.theme ]).first %>
      <% if other %><%= lc_menu_option "#{other.capitalize} theme", icon: "swatch", href: appearance_path(theme: other), method: :patch %><% end %>
      <%= lc_menu_option "Sign out @#{handle}", icon: "arrow-right-start-on-rectangle", href: session_path, method: :delete %>
    <% end %>
  <% end %>
<% end %>
