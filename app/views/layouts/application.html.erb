<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <title><%= content_for(:title).presence || "Twitter CRM" %> · Twitter CRM</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-dvh bg-background text-foreground">
    <%= lc_skip_link %>
    <% if demo? %><div class="bg-warning-soft px-inset py-related text-center text-small font-medium" role="status">Demo workspace · fictional people and activity · separate from your real data · no X requests</div><% end %>
    <div class="flex min-h-dvh">
      <% if Current.workspace %><%= render "layouts/application/sidebar" %><% end %>
      <div class="min-w-0 flex-1">
        <%= lc_container class: "px-8 xl:px-12" do %>
          <main id="main" class="<%= lc_stack_class(gap: :section) %> py-10">
            <%= yield %>
          </main>
        <% end %>
        <%= lc_toast_region id: "toasts" do %>
          <% flash.each do |kind, message| %><%= lc_toast message, tone: (kind == "alert" ? :destructive : :success), timeout: (kind == "alert" ? 0 : 4000) %><% end %>
          <% if Current.workspace && X::SyncRun.active.exists? %>
            <div hidden data-controller="refresh" data-refresh-at-value="<%= Time.current.to_f %>"></div>
            <%= lc_toast "Reading from X", tone: :neutral, timeout: 0 %>
          <% end %>
        <% end %>
      </div>
    </div>
  </body>
</html>
