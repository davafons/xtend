<% content_for :title, "Follow review" %>
<h1 class="sr-only">Follow review</h1>
<% cleanup = @cleanup %>
<% reason_hints = { "inactive" => "No post in #{cleanup.inactive_days} days", "strangers" => "No like, reply, repost, quote, mention, or DM in your data", "quiet" => "No interaction in #{cleanup.quiet_days} days" } %>
<% select_class = "w-auto field-sizing-content" %>

<div class="flex flex-wrap items-center gap-related">
  <%= view_tabs "Why to review", Follow::Cleanup::REASONS.map { |key, label| [ (@counts.key?(key) ? "#{label} · #{@counts[key]}" : label), follow_reviews_path(review_filters.merge("reason" => key)), cleanup.reason == key ] } %>
  <%= form_with url: follow_reviews_path, method: :get, class: "ms-auto flex flex-wrap items-center gap-tight", data: { controller: "auto-submit", turbo_action: "replace" } do %>
    <%= hidden_field_tag :reason, cleanup.reason, id: nil %>
    <% if cleanup.reason == "inactive" %>
      <%= lc_select Follow::Cleanup::INACTIVE_PERIODS.map { |days| [ "No post in #{days == 365 ? "a year" : "#{days} days"}", days ] }, name: "inactive", selected: cleanup.inactive_days, size: :sm, aria: { label: "Inactive for" }, data: { action: "auto-submit#submit" }, class: select_class %>
    <% elsif cleanup.reason == "quiet" %>
      <%= lc_select Follow::Cleanup::QUIET_PERIODS.map { |days| [ "Quiet #{days}+ days", days ] }, name: "quiet", selected: cleanup.quiet_days, size: :sm, aria: { label: "Quiet period" }, data: { action: "auto-submit#submit" }, class: select_class %>
    <% end %>
    <% if (tags = cleanup.tag_options).any? || cleanup.tag %>
      <%= lc_select [ [ "Any tag", "" ], [ "No tags", "untagged" ], *tags.map { |name| [ "##{name}", name ] } ], name: "tag", selected: cleanup.tag.to_s, size: :sm, aria: { label: "Tag" }, data: { action: "auto-submit#submit" }, class: select_class %>
    <% end %>
    <%= lc_select Follow::Cleanup::SORTS.map { |key, label| [ label, key ] }, name: "sort", selected: cleanup.sort, size: :sm, aria: { label: "Sort" }, data: { action: "auto-submit#submit" }, class: select_class %>
    <%= lc_select Follow::ReviewsController::BATCH_SIZES.map { |size| [ "#{size} at a time", size ] }, name: "batch", selected: @batch, size: :sm, aria: { label: "Batch size" }, data: { action: "auto-submit#submit" }, class: select_class %>
    <%= hidden_field_tag "mutuals", "0", id: nil %><%= lc_toggle "Mutuals", name: "mutuals", value: "1", active: cleanup.mutuals?, size: :sm, title: "Include mutuals; they stay marked", input: { type: "checkbox", aria: { label: "Include mutuals" }, data: { action: "auto-submit#submit" } } %>
  <% end %>
</div>

<% refresh_following = capture do %>
  <% if (url = own_list_url("following")) %><%= lc_icon_button_link_to "Scroll your following on X", url, icon: "arrow-up-right", size: :sm, target: "_blank", rel: "noopener noreferrer", title: "Scroll your following on X" %><% end %>
  <%= lc_icon_button_to "Refresh with the X API", x_sync_runs_path, params: { dataset: "following", mode: "refresh", request_key: SecureRandom.uuid, return_to: "follow_reviews" }, icon: "arrow-path", size: :sm, title: "Refresh with the X API (paid)", disabled: demo? || !X::Connection.current %>
<% end %>

<% if !cleanup.following %>
  <%= empty_state "Your following list comes first.", "Scroll your Following page on x.com to the end with the extension on.", icon: "user-plus" do %>
    <div class="flex items-center gap-tight">
      <% if (url = own_list_url("following")) %><%= lc_button_link_to "Scroll your following on X", url, size: :sm, icon: "arrow-up-right", target: "_blank", rel: "noopener noreferrer" %><% end %>
      <%= lc_button_to "Refresh with the X API", x_sync_runs_path, params: { dataset: "following", mode: "refresh", request_key: SecureRandom.uuid, return_to: "follow_reviews" }, variant: :secondary, size: :sm, icon: "arrow-path", disabled: demo? || !X::Connection.current %>
    </div>
  <% end %>
<% elsif !cleanup.ready? %>
  <%= empty_state "Leaving mutuals out needs a fresh follower list.", "Your follower list is older than a day. Scroll your Followers page on x.com to the end, or include mutuals.", icon: "shield-check" do %>
    <div class="flex items-center gap-tight">
      <% if (url = own_list_url("followers")) %><%= lc_button_link_to "Scroll your followers on X", url, size: :sm, icon: "arrow-up-right", target: "_blank", rel: "noopener noreferrer" %><% end %>
      <%= lc_button_link_to "Include mutuals", follow_reviews_path(review_filters.merge("mutuals" => "1")), variant: :secondary, size: :sm %>
    </div>
  <% end %>
<% else %>
  <div class="flex flex-wrap items-center justify-between gap-x-content gap-y-tight text-small text-muted-foreground">
    <p><%= pluralize(@counts.fetch(cleanup.reason), "account") %> · <%= reason_hints.fetch(cleanup.reason).downcase_first %><%= " · mutuals marked" if cleanup.mutuals? %></p>
    <p aria-label="Decided today">Today <span class="tabular-nums text-foreground"><%= @tally.fetch("keep", 0) %></span> kept · <span class="tabular-nums text-foreground"><%= @tally.fetch("defer", 0) %></span> deferred · <span class="tabular-nums text-foreground"><%= @tally.fetch("unfollowed", 0) + @tally.fetch("reported_unfollow", 0) %></span> unfollowed</p>
  </div>

  <% unknown = cleanup.unknown_activity_count %>
  <% if cleanup.reason == "inactive" && unknown.positive? %>
    <div class="flex items-center gap-related rounded-2xl bg-tile px-heading py-tight text-small" role="status">
      <%= lc_icon "exclamation-triangle", options: { class: "size-4 shrink-0 text-warning", "aria-hidden": true } %>
      <span class="grow" title="Visiting their profiles with the extension on fills it in, or one API following refresh reads it for everyone.">X hasn't reported when <%= pluralize(unknown, "account") %> you follow last posted, so <%= unknown == 1 ? "it isn't" : "they aren't" %> listed yet.</span>
      <%= refresh_following %>
    </div>
  <% end %>

  <% if @candidates.empty? %>
    <%= empty_state "Nothing left here.", "#{reason_hints.fetch(cleanup.reason)}: nobody else matches.", icon: "check" %>
  <% else %>
    <%= lc_card padding: :none do %>
      <ol class="divide-y divide-border" aria-label="Accounts to review">
        <% @candidates.each do |person| %>
          <%= render "candidate", person: person, cleanup: cleanup, proposal: @proposals[person.id], posts: @recent_posts[person.x_id] %>
        <% end %>
      </ol>
    <% end %>

    <% prompt = Grok::Classification.relevance_prompt(@candidates) %>
    <%= lc_collapsible card: true, indicator: :chevron do |collapsible| %>
      <% collapsible.summary do %><span class="me-auto flex items-center gap-related"><%= lc_icon "sparkles", options: { class: "size-4 text-grok", "aria-hidden": true } %>Ask Grok which of these <%= @candidates.size %> fit your interests</span><% end %>
      <div class="flex flex-col gap-content">
        <%= lc_text "Grok tags each account, adding ##{Grok::Classification::OFF_TOPIC} when nothing matches your interests. Accept suggestions in the rows, then sort by \"Off-topic first\".", size: :small, tone: :muted %>
        <div><%= lc_copy_button "Copy prompt for this batch", value: prompt, variant: :secondary, size: :sm %></div>
        <%= form_with url: grok_intakes_path, class: "flex flex-col gap-content" do %>
          <%= hidden_field_tag :return_to, "follow_reviews" %>
          <%= lc_field label: "Grok results", id: "grok-relevance-output", hint: "Paste Grok's whole answer; only its JSON block is read." do |field| %><%= lc_textarea "", name: "grok_output", rows: 4, maxlength: 100_000, required: true, **field %><% end %>
          <div><%= lc_button "Import suggestions", type: :submit, size: :sm, icon: "arrow-down-tray" %></div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if @reviews.any? %>
  <section class="flex flex-col gap-related" aria-labelledby="decided-today">
    <h2 id="decided-today" class="<%= lc_text_class(size: :small, tone: :muted) %>">Decided today</h2>
    <%= lc_card padding: :none do %>
      <ul class="divide-y divide-border">
        <% @reviews.each do |review| %>
          <% label, icon, tone = { "keep" => ["Kept", "shield-check", :success], "defer" => ["Deferred", "clock", :neutral], "reported_unfollow" => ["Unfollow reported", "user-minus", :warning], "unfollowed" => ["Unfollowed on X", "user-minus", :neutral] }.fetch(review.decision) %>
          <li class="flex items-center gap-heading px-inset py-related">
            <%= link_to review.person, class: "flex min-w-0 grow items-center gap-related" do %>
              <%= person_avatar review.person, size: :sm %>
              <span class="truncate font-semibold"><%= review.person.name %></span>
              <span class="truncate text-small text-muted-foreground">@<%= review.person.handle %></span>
            <% end %>
            <%= lc_badge(tone: tone, title: ("Checked against your next Following scroll" if review.decision == "reported_unfollow")) { safe_join([lc_icon(icon, options: { class: "size-3.5", "aria-hidden": true }), label]) } %>
            <time class="w-12 text-end text-small tabular-nums text-muted-foreground" datetime="<%= review.updated_at.iso8601 %>"><%= review.updated_at.strftime("%H:%M") %></time>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<% if @progress.decisions.any? || @progress.following.size > 1 %>
  <div class="grid grid-cols-2 gap-inset">
    <%= lc_card do %>
      <div class="flex flex-col gap-content">
        <% points = @progress.following %>
        <div class="flex items-baseline justify-between gap-related">
          <h2 class="<%= lc_text_class(size: :label) %>">Accounts you follow</h2>
          <% if points.size >= 2 %><span class="text-small tabular-nums text-muted-foreground" title="Points are complete lists and your profile's own count; between them the number is unknown."><%= points.first[1] %> → <%= points.last[1] %> since <%= points.first[0].strftime("%-d %b") %></span><% end %>
        </div>
        <% if points.size < 2 %>
          <%= lc_text "Needs two complete following lists.", size: :small, tone: :muted %>
        <% else %>
          <%= chart :line, label: "Accounts you follow at each complete list", ticks: "date",
            x: points.map { |at, _| at.to_i * 1000 }, labels: points.map { |at, _, source| "#{at.strftime("%-d %b %Y, %H:%M")} · #{source}" },
            series: [ { name: "Following", meaning: :you, values: points.map { |_, count| count } } ] %>
        <% end %>
      </div>
    <% end %>
    <%= lc_card do %>
      <div class="flex flex-col gap-content">
        <h2 class="<%= lc_text_class(size: :label) %>" title="An unfollow you reported counts once, even after the capture confirms it.">Decisions per day</h2>
        <% days = @progress.decisions %>
        <%= chart :bar, label: "Unfollows and keeps per day", stacked: true,
          labels: days.map { |day, _| day.strftime("%-d %b") }, titles: days.map { |day, _| day.strftime("%a %-d %b %Y") },
          series: [
            { name: "Unfollowed", meaning: :you, values: days.map { |_, unfollowed, _| unfollowed } },
            { name: "Kept", meaning: :both, values: days.map { |_, _, kept| kept } }
          ] %>
      </div>
    <% end %>
  </div>
<% end %>

<% if cleanup.ready? %>
  <%= lc_collapsible card: false, indicator: :chevron, summary_class: "w-fit text-small text-muted-foreground" do |collapsible| %>
    <% collapsible.summary do %>About this data<% end %>
    <div class="flex flex-col gap-tight pt-related text-small text-muted-foreground">
      <p>Kept accounts<%= " and mutuals" unless cleanup.mutuals? %> are left out<%= "; mutuals are marked, from the follower list of #{cleanup.followers.observed_at.strftime("%-d %b")}" if cleanup.mutuals? && cleanup.followers %>. Nobody needs unfollowing just to reach a number.</p>
      <p>Interaction coverage: <%= @coverage.map { |label, value| "#{label} #{value}" }.join(" · ") %>.</p>
      <p>Likes and reposts have no time of their own, so they use the post date or when the capture saw them.</p>
    </div>
  <% end %>
<% end %>
