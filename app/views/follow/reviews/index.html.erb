<% content_for :title, "Follow review" %>
<h1 class="sr-only">Follow review</h1>
<%= stat_cards [ [ "Reviewed today", @reviews.size ], [ "Kept", @tally.fetch("keep", 0) ], [ "Deferred", @tally.fetch("defer", 0) ], [ "Unfollow reported", @tally.fetch("reported_unfollow", 0) ] ] %>

<% cleanup = @cleanup %>
<% reason_hints = { "inactive" => "No post in #{cleanup.inactive_days} days", "strangers" => "No like, reply, repost, quote, mention, or DM in your data", "quiet" => "No interaction in #{cleanup.quiet_days} days" } %>
<div class="flex flex-wrap items-center gap-related">
  <%= view_tabs "Why to review", Follow::Cleanup::REASONS.map { |key, label| [ (@counts.key?(key) ? "#{label} · #{@counts[key]}" : label), follow_reviews_path(review_filters.merge("reason" => key)), cleanup.reason == key ] } %>
  <%= form_with url: follow_reviews_path, method: :get, class: "ms-auto flex flex-wrap items-center gap-related", data: { controller: "auto-submit", turbo_action: "replace" } do %>
    <%= hidden_field_tag :reason, cleanup.reason, id: nil %>
    <% if cleanup.reason == "inactive" %>
      <%= lc_select Follow::Cleanup::INACTIVE_PERIODS.map { |days| [ "No post in #{days == 365 ? "a year" : "#{days} days"}", days ] }, name: "inactive", selected: cleanup.inactive_days, size: :sm, aria: { label: "Inactive for" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
    <% elsif cleanup.reason == "quiet" %>
      <%= lc_select Follow::Cleanup::QUIET_PERIODS.map { |days| [ "Quiet #{days}+ days", days ] }, name: "quiet", selected: cleanup.quiet_days, size: :sm, aria: { label: "Quiet period" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
    <% end %>
    <%= lc_select Follow::Cleanup::SORTS.map { |key, label| [ label, key ] }, name: "sort", selected: cleanup.sort, size: :sm, aria: { label: "Sort" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
    <%= lc_select Follow::ReviewsController::BATCH_SIZES.map { |size| [ "#{size} at a time", size ] }, name: "batch", selected: @batch, size: :sm, aria: { label: "Batch size" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
    <%= hidden_field_tag "mutuals", "0", id: nil %><%= lc_toggle "Include mutuals", name: "mutuals", value: "1", active: cleanup.mutuals?, size: :sm, input: { type: "checkbox", data: { action: "auto-submit#submit" } } %>
  <% end %>
</div>

<% refresh_following = capture do %>
  <%= lc_button_to "Refresh following", x_sync_runs_path, params: { dataset: "following", mode: "refresh", request_key: SecureRandom.uuid, return_to: "follow_reviews" }, variant: :secondary, size: :sm, icon: "arrow-path", disabled: demo? || !X::Connection.current %>
<% end %>
<% if !cleanup.following %>
  <%= empty_state "Your following list comes first.", "Read the accounts you follow once; suggestions only come from a complete list.", icon: "user-plus" do %><%= refresh_following %><% end %>
<% elsif !cleanup.ready? %>
  <%= empty_state "Leaving mutuals out needs a fresh follower list.", "Your follower list is older than 24 hours, so it can't show who still follows you. Include mutuals, or refresh followers on X data.", icon: "shield-check" do %>
    <%= lc_button_link_to "Include mutuals", follow_reviews_path(review_filters.merge("mutuals" => "1")), variant: :secondary %>
  <% end %>
<% else %>
  <% unknown = cleanup.unknown_activity_count %>
  <% if cleanup.reason == "inactive" && unknown.positive? %>
    <%= lc_alert "X hasn't reported when #{pluralize(unknown, "account")} you follow last posted, so #{unknown == 1 ? "it" : "they"} can't show up here yet. One following refresh reads that for everyone.", tone: :warning do %><%= refresh_following %><% end %>
  <% end %>
<% end %>
<% if cleanup.ready? && @candidates.empty? %>
  <%= empty_state "Nothing left here.", "#{reason_hints.fetch(cleanup.reason)}: nobody else matches. There's no need to unfollow someone just to reach a number.", icon: "check" %>
<% elsif cleanup.ready? %>
  <%= lc_card padding: :none, class: "overflow-hidden" do %>
    <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Accounts to review">
      <%= lc_table do %>
        <caption class="sr-only">Accounts to review</caption>
        <thead>
          <tr>
            <th scope="col">Account</th>
            <th scope="col" class="text-end max-xl:hidden">Followers</th>
            <th scope="col">Last post</th>
            <th scope="col">Last interaction</th>
            <th scope="col" class="text-end">Decision</th>
          </tr>
        </thead>
        <tbody>
          <% @candidates.each do |person| %>
            <tr id="<%= dom_id(person, :review) %>">
              <th scope="row" class="align-top font-normal">
                <div class="<%= lc_stack_class(gap: :related) %> max-w-xs">
                  <%= render "people/identity", person: person %>
                  <div class="<%= lc_stack_class(gap: :tight) %> ps-11">
                    <span class="flex flex-wrap items-center gap-related text-caption text-muted-foreground">
                      <% if cleanup.mutual?(person) %><%= relationship_badge "Mutual" %><% end %>
                      <%= safe_join([ ("Joined #{person.joined_x_at.strftime('%b %Y')}" if person.joined_x_at), (person.location.truncate(24) if person.location.present?) ].compact, " · ") %>
                    </span>
                    <span class="line-clamp-2 text-small <%= "text-muted-foreground" if person.description.blank? %>"><%= person.description.presence || "No bio collected." %></span>
                    <% if person.notes.present? %><span class="line-clamp-2 text-caption"><strong>Your note:</strong> <%= person.notes %></span><% end %>
                  </div>
                </div>
              </th>
              <td class="whitespace-nowrap align-top text-end text-small tabular-nums max-xl:hidden">
                <%= compact_count person.followers_count %>
                <% if person.following_count %><span class="block text-caption text-muted-foreground">follows <%= compact_count person.following_count %></span><% end %>
                <% if person.posts_count %><span class="block text-caption text-muted-foreground"><%= compact_count person.posts_count %> posts</span><% end %>
              </td>
              <% posted = cleanup.last_active[person.id] %>
              <td class="whitespace-nowrap align-top text-small">
                <% if posted %>
                  <span class="block font-medium"><%= relative_day posted %></span>
                  <span class="block text-caption text-muted-foreground"><%= posted.strftime("%-d %b %Y") %></span>
                <% else %>
                  <span class="block text-muted-foreground">Unknown</span>
                <% end %>
              </td>
              <% interactions = cleanup.interactions.fetch(person.id) %>
              <td class="min-w-36 align-top text-small">
                <% if (latest = interactions.latest) %>
                  <span class="block font-medium">Quiet for <%= "up to " if latest.approximate? %><%= pluralize((Date.current - latest.at.to_date).to_i, "day") %></span>
                  <span class="block text-caption text-muted-foreground"><%= interaction_label(latest) %></span>
                <% else %>
                  <span class="block font-medium">Nothing observed</span>
                  <span class="block text-caption text-muted-foreground">in collected history</span>
                <% end %>
                <% if interactions.awaiting_dm_reply? %><%= lc_badge "They sent the last DM", tone: :warning, class: "mt-tight" %><% end %>
              </td>
              <td class="align-top">
                <div class="flex flex-wrap items-center justify-end gap-tight max-xl:w-44">
                  <% unless demo? %><%= lc_icon_button_link_to "Open @#{person.handle} on X", person.profile_url, icon: "arrow-up-right", size: :sm, target: "_blank", rel: "noopener noreferrer", title: "Open on X" %><% end %>
                  <%= lc_button_to "Keep", follow_reviews_path(review_filters.merge(person_id: person.id, decision: "keep")), variant: :secondary, size: :sm, icon: "shield-check" %>
                  <%= lc_icon_button_to "Defer until tomorrow", follow_reviews_path(review_filters.merge(person_id: person.id, decision: "defer")), icon: "clock", size: :sm, title: "Defer until tomorrow" %>
                  <%= lc_button_to "I unfollowed", follow_reviews_path(review_filters.merge(person_id: person.id, decision: "reported_unfollow")), variant: :secondary, size: :sm, icon: "user-minus", class: "whitespace-nowrap" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </div>
  <% end %>
  <%= lc_text "#{reason_hints.fetch(cleanup.reason)}. #{pluralize(@counts.fetch(cleanup.reason), "account")} match. Kept accounts#{" and mutuals" unless cleanup.mutuals?} are left out#{"; mutuals are marked" if cleanup.mutuals?}#{" (follower list from #{cleanup.followers.observed_at.strftime("%-d %b")})" if cleanup.mutuals? && cleanup.followers}. Interaction coverage: #{@coverage.map { |label, value| "#{label} #{value}" }.join(" · ")}. Likes and reposts have no time of their own, so they use the post date or when the capture saw them.", size: :caption, tone: :muted %>
<% end %>

<% if @reviews.any? %>
  <div class="flex flex-col gap-content">
    <%= lc_heading "Decided today", level: 2, size: :heading %>
    <%= lc_card padding: :none, class: "overflow-hidden" do %>
      <%= lc_table do %>
        <caption class="sr-only">Decisions made today</caption>
        <thead><tr><th scope="col">Account</th><th scope="col">Decision</th><th scope="col" class="text-end">Time</th></tr></thead>
        <tbody>
          <% @reviews.each do |review| %>
            <tr>
              <th scope="row" class="font-normal"><%= link_to review.person, class: "flex items-center gap-heading" do %><%= person_avatar review.person, size: :sm %><span class="font-semibold"><%= review.person.name %></span><span class="text-caption text-muted-foreground">@<%= review.person.handle %></span><% end %></th>
              <td>
                <% label, icon, tone = { "keep" => ["Keep following", "shield-check", :success], "defer" => ["Deferred", "clock", :neutral], "reported_unfollow" => ["Unfollow reported · unverified", "user-minus", :warning] }.fetch(review.decision) %>
                <%= lc_badge(tone: tone) { safe_join([lc_icon(icon, options: { class: "size-3.5", "aria-hidden": true }), label]) } %>
              </td>
              <td class="text-end text-caption tabular-nums text-muted-foreground"><%= review.updated_at.strftime("%H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    <% end %>
  </div>
<% end %>
