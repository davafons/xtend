<% content_for :title, "Follow review" %>
<div class="flex items-end justify-between gap-8 pb-6 pt-8">
  <div class="flex flex-col gap-3">
    <div class="flex items-center gap-4">
      <%= lc_heading "Follow review", level: 1, size: :title %>
    </div>
    <%= lc_text "Accounts you follow that don't follow back and have no observed reply, mention, DM, like, or bookmark in the chosen period. Open X to unfollow; the app never does.", tone: :muted %>
  </div>
  <dl class="flex shrink-0 gap-6 text-end">
    <% [["Reviewed today", @reviews.size], ["Kept", @tally.fetch("keep", 0)], ["Deferred", @tally.fetch("defer", 0)], ["Unfollow reported", @tally.fetch("reported_unfollow", 0)]].each do |label, value| %>
      <div><dd class="text-2xl font-semibold tabular-nums"><%= value %></dd><dt class="text-xs text-muted-foreground"><%= label %></dt></div>
    <% end %>
  </dl>
</div>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3 text-sm text-muted-foreground">
  <p>
    Followers checked <%= @followers&.observed_at&.strftime("%-d %b, %H:%M") || "never" %> · following checked <%= @following&.observed_at&.strftime("%-d %b, %H:%M") || "never" %>
    <% if @followers&.fresh? && @following %> · <span class="tabular-nums"><%= pluralize(@remaining, "account") %></span> eligible<% end %>
  </p>
  <%= form_with url: follow_reviews_path, method: :get, class: "flex items-center gap-2", data: { controller: "auto-submit", turbo_action: "replace" } do %>
    <%= lc_select Follow::ReviewsController::QUIET_PERIODS.map { |days| ["Quiet #{days}+ days", days] }, name: "quiet", selected: @quiet, size: :sm, aria: { label: "Quiet period" }, data: { action: "auto-submit#submit" }, class: "w-auto" %>
    <%= lc_select Follow::ReviewsController::SORTS.map { |key, (label, _)| [label, key] }, name: "sort", selected: @sort, size: :sm, aria: { label: "Order candidates by" }, data: { action: "auto-submit#submit" }, class: "w-auto" %>
    <%= lc_select Follow::ReviewsController::BATCH_SIZES.map { |size| ["#{size} at a time", size] }, name: "batch", selected: @batch, size: :sm, aria: { label: "Batch size" }, data: { action: "auto-submit#submit" }, class: "w-auto" %>
    <%= lc_button "Apply", type: :submit, variant: :secondary, size: :sm, class: "sr-only" %>
  <% end %>
</div>

<% if !@followers&.fresh? || !@following %>
  <%= lc_card class: "py-10" do %>
    <div class="flex flex-col items-start gap-4">
      <%= lc_heading "Fresh follow data comes first.", level: 2, size: :subheading %>
      <%= lc_text "We need a complete follower list from the last 24 hours before suggesting anyone. Missing data should never put a mutual in your cleanup queue.", tone: :muted %>
      <%= lc_button_link_to "Review data sources", x_sources_path, variant: :secondary %>
    </div>
  <% end %>
<% elsif @candidates.empty? %>
  <%= lc_card do %>
    <%= lc_heading "You're done for now.", level: 2, size: :subheading %>
    <%= lc_text "No more eligible accounts. There is no need to unfollow someone just to reach a number.", tone: :muted, class: "mt-3" %>
  <% end %>
<% else %>
  <%= lc_card padding: :none, class: "overflow-hidden" do %>
    <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Accounts to review">
      <%= lc_table do %>
        <caption class="sr-only">Accounts to review</caption>
        <thead>
          <tr>
            <th scope="col">Account</th>
            <th scope="col" class="text-end">Followers</th>
            <th scope="col">Last interaction</th>
            <th scope="col">Bio</th>
            <th scope="col" class="text-end">Decision</th>
          </tr>
        </thead>
        <tbody>
          <% @candidates.each do |person| %>
            <tr id="<%= dom_id(person, :review) %>">
              <th scope="row" class="align-top font-normal">
                <%= link_to person, class: "flex min-w-52 items-center gap-3" do %>
                  <%= person_avatar person %>
                  <span class="min-w-0">
                    <span class="flex items-center gap-1.5 font-semibold"><span class="truncate"><%= person.name %></span><% if person.pin %><%= lc_icon "bookmark", variant: :solid, options: { class: "size-3.5 text-primary", "aria-label": "Pinned" } %><% end %></span>
                    <span class="block text-xs text-muted-foreground">@<%= person.handle %></span>
                    <span class="mt-1 block text-xs text-muted-foreground"><%= safe_join([("Joined #{person.joined_x_at.strftime('%b %Y')}" if person.joined_x_at), (person.location.truncate(24) if person.location.present?)].compact, " · ") %></span>
                    <% if (posted = @latest_posts[person.x_id]) %><span class="block text-xs text-muted-foreground">Last collected post <%= relative_day posted %></span><% end %>

                  </span>
                <% end %>
              </th>
              <td class="whitespace-nowrap align-top text-end text-sm tabular-nums">
                <%= compact_count person.followers_count %>
                <% if person.following_count %><span class="block text-xs text-muted-foreground">follows <%= compact_count person.following_count %></span><% end %>
                <% if person.posts_count %><span class="block text-xs text-muted-foreground"><%= compact_count person.posts_count %> posts</span><% end %>
              </td>
              <% interactions = @interactions.fetch(person.id) %>
              <td class="min-w-48 align-top text-sm">
                <% if (latest = interactions.latest) %>
                  <span class="block font-medium">Quiet for <%= "up to " if latest.approximate? %><%= pluralize((Date.current - latest.at.to_date).to_i, "day") %></span>
                  <span class="block text-xs text-muted-foreground"><%= interaction_label(latest) %></span>
                <% else %>
                  <span class="block font-medium">Nothing observed</span>
                  <span class="block text-xs text-muted-foreground">in collected history</span>
                <% end %>
                <% if interactions.awaiting_dm_reply? %><%= lc_badge "They sent the last DM", tone: :warning, class: "mt-1" %><% end %>
              </td>
              <td class="max-w-sm align-top text-sm"><span class="line-clamp-3 <%= 'text-muted-foreground' if person.description.blank? %>"><%= person.description.presence || "No bio collected." %></span><% if person.notes.present? %><span class="mt-1 block line-clamp-2 text-xs"><strong>Your note:</strong> <%= person.notes %></span><% end %></td>
              <td class="align-top">
                <div class="flex items-center justify-end gap-1">
                  <%= source_link "Open X", person.profile_url, variant: :ghost, size: :sm %>
                  <%= lc_button_to "Keep", follow_reviews_path(person_id: person.id, decision: "keep", batch: params[:batch], sort: params[:sort], quiet: params[:quiet]), variant: :secondary, size: :sm, icon: "shield-check" %>
                  <%= lc_button_to "Defer", follow_reviews_path(person_id: person.id, decision: "defer", batch: params[:batch], sort: params[:sort], quiet: params[:quiet]), variant: :ghost, size: :sm, icon: "clock" %>
                  <%= lc_button_to "I unfollowed", follow_reviews_path(person_id: person.id, decision: "reported_unfollow", batch: params[:batch], sort: params[:sort], quiet: params[:quiet]), variant: :ghost, size: :sm, icon: "user-minus" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </div>
  <% end %>
  <p class="mt-3 text-xs text-muted-foreground">Mutuals, kept accounts, and anyone with an observed interaction in the last <%= @quiet %> days are excluded. Coverage: <%= safe_join(@coverage.map { |label, value| "#{label} #{value}" }, " · ") %>. X doesn't report when you liked or bookmarked a post, so those use the post date or the previous check as a lower bound. Open the person to check their timeline.</p>
<% end %>

<% if @reviews.any? %>
  <div class="mt-10 flex flex-col gap-4">
    <%= lc_heading "Decided today", level: 2, size: :heading %>
    <%= lc_card padding: :none, class: "overflow-hidden" do %>
      <%= lc_table do %>
        <caption class="sr-only">Decisions made today</caption>
        <thead><tr><th scope="col">Account</th><th scope="col">Decision</th><th scope="col" class="text-end">Time</th></tr></thead>
        <tbody>
          <% @reviews.each do |review| %>
            <tr>
              <th scope="row" class="font-normal"><%= link_to review.person, class: "flex items-center gap-3" do %><%= person_avatar review.person, size: :sm %><span class="font-semibold"><%= review.person.name %></span><span class="text-xs text-muted-foreground">@<%= review.person.handle %></span><% end %></th>
              <td>
                <% label, icon, tone = { "keep" => ["Keep following", "shield-check", :success], "defer" => ["Deferred", "clock", :neutral], "reported_unfollow" => ["Unfollow reported · unverified", "user-minus", :warning] }.fetch(review.decision) %>
                <%= lc_badge(tone: tone) { safe_join([lc_icon(icon, options: { class: "size-3.5", "aria-hidden": true }), label]) } %>
              </td>
              <td class="text-end text-xs tabular-nums text-muted-foreground"><%= review.updated_at.strftime("%H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    <% end %>
  </div>
<% end %>
