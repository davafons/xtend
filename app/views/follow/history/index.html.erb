<% content_for :title, "Followers" %>
<h1 class="sr-only">Followers</h1>
<div class="flex flex-wrap items-center gap-related">
  <%= view_tabs "Follower views", Follow::HistoryController::VIEWS.map { |key, label| [ "#{label} · #{@counts[key]}", follower_history_path(view: key), @view == key ] } %>
  <div class="ms-auto flex items-center gap-tight">
    <p class="text-small text-muted-foreground" title="Complete follower lists compared">
      <% if @checks.any? %><%= @checks.map { |check| check.observed_at.strftime("%-d %b, %H:%M") }.join(" vs ") %><% else %>No complete follower list yet<% end %>
    </p>
    <% if (url = own_list_url("followers")) %><%= lc_icon_button_link_to "Scroll your followers on X", url, size: :sm, icon: "arrow-up-right", target: "_blank", rel: "noopener noreferrer", title: "Scroll your followers on X to save a new complete list" %><% end %>
  </div>
</div>

<p class="flex flex-wrap items-center gap-x-content gap-y-tight text-small text-muted-foreground">
  <span><span class="tabular-nums text-foreground"><%= number_with_delimiter @counts["current"] %></span> followers</span>
  <% if @counts["current"].positive? %><span>you follow back <span class="tabular-nums text-foreground"><%= (@follow_back * 100.0 / @counts["current"]).round %>%</span></span><% end %>
  <% if @new_since_last || @lost_since_last %><span>last check <span class="tabular-nums text-success">+<%= @new_since_last || 0 %></span> <span class="tabular-nums text-warning">−<%= @lost_since_last || 0 %></span></span><% end %>
  <% if @duration %><span title="Mean range across <%= @duration[:count] %> completed periods with observed starts. Ongoing follows and unknown starts are excluded.">follows last <span class="tabular-nums text-foreground"><%= @duration[:minimum_days].round(1) %>–<%= @duration[:maximum_days].round(1) %> days</span></span><% end %>
</p>

<% if @view == "changes" %>
  <%= render "changes", changes: @follower_changes, graph: @graph %>
<% elsif @periods.empty? %>
  <% title, text = { "new" => [ "No new followers yet.", "The first complete list is a baseline; later ones show who started following." ], "lost" => [ "No losses yet.", "A loss shows when a later complete list no longer includes someone." ], "not_followed_back" => [ "You follow back everyone who follows you.", nil ], "current" => [ "No complete follower list yet.", "Scroll your Followers page on x.com to the end with the extension on." ] }.fetch(@view) %>
  <%= lc_empty_state title: title, text: text, icon: "user-group", card: true %>
<% else %>
  <%= lc_card padding: :none, class: "overflow-hidden" do %>
    <div class="overflow-x-auto" tabindex="0" role="region" aria-label="<%= Follow::HistoryController::VIEWS.fetch(@view) %>">
      <%= lc_table do %>
        <caption class="sr-only"><%= Follow::HistoryController::VIEWS.fetch(@view) %></caption>
        <thead>
          <tr>
            <th scope="col">Person</th>
            <th scope="col" class="text-end max-xl:hidden">Followers</th>
            <th scope="col">Replies</th>
            <% if @view == "new" %>
              <th scope="col">Started following</th>
              <th scope="col">First reply after</th>
            <% elsif @view == "lost" %>
              <th scope="col">Followed you</th>
              <th scope="col">Stopped</th>
            <% else %>
              <th scope="col">You follow back</th>
              <th scope="col">Following you since</th>
            <% end %>
            <th scope="col">Last reply</th>
          </tr>
        </thead>
        <tbody>
          <% @periods.each do |period| %>
            <% person = period.person %>
            <tr>
              <th scope="row" class="font-normal">
                <%= render "people/identity", person: person %>
              </th>
              <td class="whitespace-nowrap text-end text-small tabular-nums max-xl:hidden"><%= compact_count person.followers_count %></td>
              <td>
                <%= relationship_badge person.reply_state %>
                <% if person.reply_events.any? %><span class="ms-tight text-caption tabular-nums text-muted-foreground">↗<%= person.outgoing_count %> ↙<%= person.incoming_count %></span><% end %>
              </td>
              <% if @view == "new" %>
                <td class="text-small"><%= period.followed_after.strftime("%-d %b") %>–<%= period.first_seen_at.strftime("%-d %b %Y") %><% unless period.ended_by %><span class="block text-caption text-muted-foreground">still following</span><% end %></td>
                <td class="text-small">
                  <% window = period.interaction_window(1) %>
                  <%= window ? "#{window[:minimum_days].round(1)}–#{window[:maximum_days].round(1)} days" : tag.span("No reply yet", class: "text-muted-foreground") %>
                  <% if period.ambiguous_early_replies? %><span class="block text-caption text-muted-foreground">earlier replies in the detection window</span><% end %>
                </td>
              <% elsif @view == "lost" %>
                <td class="text-small"><%= period.baseline? ? "Before #{period.first_seen_at.strftime('%-d %b %Y')}" : "#{period.followed_after.strftime('%-d %b')}–#{period.first_seen_at.strftime('%-d %b %Y')}" %></td>
                <td class="text-small"><%= period.last_seen_at.strftime("%-d %b") %>–<%= period.ended_by.strftime("%-d %b %Y") %></td>
              <% else %>
                <td><%= @graph.following?(person) ? relationship_badge("Mutual") : lc_badge("Not yet") %></td>
                <td class="text-small">
                  <% if period.baseline? %><span class="text-muted-foreground">Before <%= period.first_seen_at.strftime("%-d %b %Y") %></span>
                  <% else %><%= period.followed_after.strftime("%-d %b") %>–<%= period.first_seen_at.strftime("%-d %b %Y") %><% end %>
                  <% if person.follower_periods.size > 1 %><span class="block text-caption text-muted-foreground">followed again</span><% end %>
                </td>
              <% end %>
              <td class="text-small"><%= relative_day person.last_interaction_at %></td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= lc_collapsible card: false, indicator: :chevron, summary_class: "w-fit text-small text-muted-foreground" do |collapsible| %>
  <% collapsible.summary do %>About this data<% end %>
  <div class="flex flex-col gap-tight pt-related text-small text-muted-foreground">
    <p>A follow or unfollow happened somewhere between two checks, so dates are ranges. Follows that start and end between checks stay invisible.</p>
    <p>A disappearance can be a suspension or deactivation, not only an unfollow.</p>
    <p><% if @duration %>How long follows last is the mean range across <%= pluralize(@duration[:count], "completed period") %> with observed starts.<% else %>How long follows last needs a follower who started and then stopped between checks.<% end %> Followers from the first check have unknown start dates.</p>
    <p>Scrolling your Followers page on x.com to the end with the extension on saves a list for free; an X API check costs about $0.17.</p>
  </div>
<% end %>
