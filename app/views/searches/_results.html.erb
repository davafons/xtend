<%# The palette's rows: commands always, then what the query matched. Blank, it shows pages, actions and recent people. %>
<% matching = ->(rows) { search.blank? ? rows : rows.select { |title, _, _, keywords| "#{title} #{keywords}".downcase.include?(search.query.downcase) } } %>
<% pages = navigation_sections.flat_map { |section, items| items.map { |label, path, icon| [ label, path, icon, section ] } } + [ [ "Settings", settings_path, "cog-6-tooth", "workspace interests account" ] ] %>
<% actions = [
     [ "New idea", drafts_path, "light-bulb", "compose draft tweet post write" ],
     [ "Add a person", new_person_path, "user-plus", "create contact" ],
     [ "Ideas to post about", ideas_drafts_path, "sparkles", "replies expand focus grok ai angles" ],
     [ "Collect from X", x_sources_path(anchor: "collection"), "arrow-down-tray", "sample sync refresh likes bookmarks dms" ],
     [ "Browser capture", x_sources_path(anchor: "capture"), "puzzle-piece", "extension token" ],
     [ "Record X spend", x_billing_cycles_path, "banknotes", "billing cycle budget allowance" ]
   ] %>
<% unless search.blank? %>
  <% if (person = search.named_person) %>
    <%= lc_search_group person.name do %>
      <%= lc_search_result "Set a reminder for #{person.name}", person_path(person, anchor: "reminders"), detail: "Pick a day and what to bring up", icon: "bell" %>
      <%= lc_search_result "Their posts and your replies", person_path(person), detail: "Everything saved between you and @#{person.handle}", icon: "chat-bubble-left-right" %>
      <% unless demo? %><%= lc_search_result "Open @#{person.handle} on X", person.profile_url, detail: "x.com profile, in a new tab", icon: "arrow-up-right", target: "_blank", rel: "noopener noreferrer" %><% end %>
    <% end %>
  <% end %>
  <% if search.people.any? %>
    <%= lc_search_group "People" do %>
      <% search.people.each do |person| %>
        <%= person_search_result person, graph: search.follow_graph, match: search.match_in(person), query: search.query %>
      <% end %>
    <% end %>
  <% end %>
  <% if search.tags.any? %>
    <%= lc_search_group "Tags" do %>
      <% search.tags.each do |tag| %><%= tag_search_result tag, search.tagged_people(tag) %><% end %>
    <% end %>
  <% end %>
  <% if search.drafts.any? %>
    <%= lc_search_group "Drafts" do %>
      <% search.drafts.each do |draft| %><%= draft_search_result draft %><% end %>
    <% end %>
  <% end %>
  <% if search.posts.any? %>
    <%= lc_search_group "Posts" do %>
      <% search.posts.each do |post| %><%= post_search_result post, search.post_authors[post.author_x_id], query: search.query %><% end %>
    <% end %>
  <% end %>
  <%= lc_search_group "Everywhere" do %>
    <%= lc_search_result "People matching “#{search.query}”", people_path(q: search.query), detail: "Search names, handles, bios, and notes", icon: "users" %>
    <%= lc_search_result "All saved posts matching “#{search.query}”", timeline_path(q: search.query, who: "seen", period: "all", kind: "all"), detail: pluralize(number_with_delimiter(search.post_count), "post"), icon: "queue-list" %>
  <% end %>
<% end %>
<% if (rows = matching.(actions)).any? %>
  <%= lc_search_group "Actions" do %>
    <% rows.each do |title, path, icon, keywords| %><%= lc_search_result title, path, icon: icon, keywords: keywords %><% end %>
  <% end %>
<% end %>
<% if (rows = matching.(pages)).any? %>
  <%= lc_search_group "Go to" do %>
    <% rows.each do |title, path, icon, keywords| %><%= lc_search_result title, path, icon: icon, keywords: keywords %><% end %>
  <% end %>
<% end %>
<% if search.blank? && search.recent_people.any? %>
  <%= lc_search_group "Recent conversations" do %>
    <% search.recent_people.each do |person| %><%= person_search_result person, graph: search.follow_graph, detail: "replied #{time_ago_in_words(person.last_interaction_at)} ago" %><% end %>
  <% end %>
<% end %>
