<%= lc_card do %>
  <div class="flex flex-col gap-content">
    <%= lc_field label: "Stage", id: "draft-status" do |field| %>
      <%= lc_select Draft::STATUSES.map { |key, label| [label, key] }, name: "draft[status]", selected: draft.status, form: "draft-form", **field %>
    <% end %>
    <%= lc_field label: "Topic", id: "draft-topic" do |field| %>
      <%= lc_input name: "draft[topic]", value: draft.topic, list: "draft-topics", form: "draft-form", **field %>
      <datalist id="draft-topics"><% Current.workspace.interests.each do |interest| %><option value="<%= interest %>"></option><% end %></datalist>
    <% end %>
    <%= lc_field label: "Notes", id: "draft-notes" do |field| %>
      <%= lc_textarea draft.notes, name: "draft[notes]", rows: 4, form: "draft-form", placeholder: "Angles, sources, who might care. Never posted.", **field %>
    <% end %>
    <% if draft.inspiration_url.present? || (draft.posted_url && !demo?) %>
      <div class="flex flex-col gap-tight text-small text-muted-foreground">
        <% if draft.inspiration_url.present? %>
          <%= link_to draft.inspiration_url, target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-tight hover:text-foreground" do %><%= lc_icon "light-bulb", options: { class: "size-4", "aria-hidden": true } %>Inspired by this post<% end %>
        <% end %>
        <% if draft.posted_url && !demo? %>
          <%= link_to draft.posted_url, target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-tight text-you hover:underline" do %><%= lc_icon "arrow-up-right", options: { class: "size-4", "aria-hidden": true } %>Posted <%= draft.posted_at&.strftime("%-d %b %Y, %H:%M") %><% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
