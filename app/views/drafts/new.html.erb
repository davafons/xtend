<% content_for :title, "New draft" %>
<div class="mx-auto grid w-full max-w-[60rem] grid-cols-[minmax(0,600px)_20rem] items-start gap-section">
  <div class="flex flex-col">
    <div class="flex items-center border-b border-border px-related py-related">
      <%= lc_icon_button_link_to "Back to drafts", drafts_path, icon: "arrow-left", title: "Back to drafts" %>
    </div>
    <%= render "form", draft: @draft %>
  </div>
  <aside class="sticky top-6"><%= render "details", draft: @draft %></aside>
</div>
