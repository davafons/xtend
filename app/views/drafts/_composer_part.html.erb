<%# locals: (text:, placeholder:, form: nil) %>
<li class="group grid grid-cols-[2.75rem_minmax(0,1fr)] gap-x-heading" data-composer-target="part">
  <div class="flex flex-col items-center gap-tight">
    <%= owner_avatar size: 11 %>
    <span class="-mb-tight w-0.5 grow bg-border group-last:invisible" aria-hidden="true"></span>
  </div>
  <div class="flex items-start gap-related pb-content">
    <%= lc_textarea text, name: "draft[parts][]", rows: 2, placeholder: placeholder, form: form,
      class: "min-h-0 resize-none overflow-hidden border-0 px-0 pt-2.5 text-[20px] font-normal leading-snug placeholder:font-normal shadow-none [--lc-field-bg:transparent] focus-visible:outline-none focus-visible:ring-0",
      data: { composer_target: "input", action: "input->composer#edit focus->composer#focus" } %>
    <%= lc_icon_button "Remove this post", icon: "x-mark", size: :sm, class: "mt-2", title: "Remove this post", data: { remove: true, action: "composer#remove" }, hidden: true %>
  </div>
</li>
