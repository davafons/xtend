<%# An X-style composer. Each post in a thread is its own field; the form stores them as one body. %>
<%# locals: (parts:, placeholder: "What's happening?", submit: "Save", form: nil, intent: false, required: false) %>
<div class="flex flex-col" data-controller="composer" data-composer-required-value="<%= required %>">
  <ol class="flex flex-col" data-composer-target="list">
    <% (parts.presence || [ "" ]).each do |text| %>
      <%= render "drafts/composer_part", text: text, placeholder: placeholder, form: form %>
    <% end %>
  </ol>
  <template data-composer-target="template"><%= render "drafts/composer_part", text: "", placeholder: "Add another post", form: form %></template>
  <div class="ms-14 flex items-center gap-heading border-t border-border pt-heading">
    <span class="text-small text-muted-foreground" data-composer-target="summary"></span>
    <div class="ms-auto flex items-center gap-heading">
      <%= lc_char_counter max: 280, count: 0, class: "text-you", data: { action: "composer:count@window->lc-char-counter#update" } %>
      <span class="h-6 w-px bg-border" data-composer-target="divider" aria-hidden="true" hidden></span>
      <%= lc_icon_button "Add post", icon: "plus", size: :sm, variant: :outline, class: "text-you", title: "Add post", data: { action: "composer#add" } %>
      <% if intent %>
        <%= lc_icon_button_link_to "Open in X", "https://x.com/intent/post", icon: "arrow-up-right", size: :sm, target: "_blank", rel: "noopener noreferrer",
          title: "Open in X with the first post filled in. Once posted, set the stage to Posted; the next refresh of your posts links the tweet.", data: { composer_target: "intent" } %>
      <% end %>
      <%= lc_button submit, type: :submit, form: form, data: { composer_target: "submit" } %>
    </div>
  </div>
</div>
