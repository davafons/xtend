<% content_for :title, "Inspiration" %>
<h1 class="sr-only">What to post about</h1>
<% name, handle = owner_identity %>
<% replies = @ideas.replies_to_expand %>
<% questions = @ideas.questions %>

<div class="grid items-start gap-section lg:grid-cols-[minmax(0,1fr)_20rem]">
  <div class="flex flex-col">
    <%= compose_tabs counts: Draft.group(:status).count, inspiration: true %>

    <section aria-labelledby="replies-heading" class="border-b border-border">
      <h2 id="replies-heading" class="px-content pt-content text-caption font-semibold text-muted-foreground" title="Your longer replies in conversations that became two-way">Replies worth expanding</h2>
      <% if replies.empty? %>
        <p class="px-content py-content text-small text-muted-foreground">None yet. Longer replies in two-way conversations show up here.</p>
      <% end %>
      <ol class="flex flex-col divide-y divide-border">
        <% replies.each do |post| %>
          <%= render layout: "drafts/post", locals: { avatar: owner_avatar(size: 11), name: name, handle: handle, time: x_post_time(post.published_at) } do %>
            <p class="whitespace-pre-line break-words"><%= @ideas.strip_mentions(post.body) %></p>
            <div class="-ms-2 mt-tight flex items-center gap-related text-muted-foreground">
              <%= lc_icon_button_to "Draft a post from this reply", drafts_path, params: { open: "1", draft: { status: "drafting", body: @ideas.strip_mentions(post.body), inspiration_url: @ideas.status_url(post) } }, icon: "pencil-square", size: :sm, class: "text-you", title: "Draft a post from this reply" %>
              <% unless demo? %><%= lc_icon_button_link_to "Open the conversation on X", @ideas.status_url(post), icon: "arrow-up-right", size: :sm, target: "_blank", rel: "noopener noreferrer", title: "Open the conversation on X" %><% end %>
            </div>
          <% end %>
        <% end %>
      </ol>
    </section>

    <section aria-labelledby="questions-heading" class="border-b border-border">
      <h2 id="questions-heading" class="px-content pt-content text-caption font-semibold text-muted-foreground">Questions people asked you</h2>
      <% if questions.empty? %>
        <p class="px-content py-content text-small text-muted-foreground">No questions in collected replies yet.</p>
      <% end %>
      <ol class="flex flex-col divide-y divide-border">
        <% questions.each do |post| %>
          <% author = @ideas.authors[post.author_x_id] %>
          <% author_name = author ? link_to(author.name, author, class: "hover:underline") : "Someone" %>
          <%= render layout: "drafts/post", locals: { avatar: (author ? person_avatar(author, size: 11) : lc_avatar("?", size: 11)), name: author_name, handle: author&.handle, time: x_post_time(post.published_at) } do %>
            <p class="whitespace-pre-line break-words"><%= @ideas.strip_mentions(post.body) %></p>
            <div class="-ms-2 mt-tight flex items-center gap-related text-muted-foreground">
              <%= lc_icon_button_to "Answer in a post", drafts_path, params: { open: "1", draft: { status: "drafting", notes: "Question from @#{author&.handle}: #{@ideas.strip_mentions(post.body)}", inspiration_url: @ideas.status_url(post), topic: nil } }, icon: "chat-bubble-oval-left", size: :sm, class: "text-you", title: "Answer in a post" %>
              <% unless demo? %><%= lc_icon_button_link_to "Open on X", @ideas.status_url(post), icon: "arrow-up-right", size: :sm, target: "_blank", rel: "noopener noreferrer", title: "Open on X" %><% end %>
            </div>
          <% end %>
        <% end %>
      </ol>
    </section>

    <section aria-labelledby="posts-heading">
      <h2 id="posts-heading" class="px-content pt-content text-caption font-semibold text-muted-foreground" title="Reply counts as of the last collection">What you posted recently</h2>
      <% if @ideas.own_posts.empty? %>
        <p class="px-content py-content text-small text-muted-foreground">No original posts collected yet.</p>
      <% end %>
      <ol class="flex flex-col divide-y divide-border">
        <% @ideas.own_posts.each do |post| %>
          <%= render layout: "drafts/post", locals: { avatar: owner_avatar(size: 11), name: name, handle: handle, time: x_post_time(post.published_at) } do %>
            <p class="line-clamp-4 whitespace-pre-line break-words"><%= CGI.unescapeHTML(post.body) %></p>
            <div class="mt-related flex items-center gap-tight text-small text-muted-foreground" title="Replies when last collected">
              <%= lc_icon "chat-bubble-oval-left", options: { class: "size-[18px]", "aria-hidden": true } %>
              <span class="sr-only">Replies:</span><span class="tabular-nums"><%= post.reply_count || "—" %></span>
            </div>
          <% end %>
        <% end %>
      </ol>
    </section>
  </div>

  <%= render "drafts/sidebar", ideas: @ideas %>
</div>
