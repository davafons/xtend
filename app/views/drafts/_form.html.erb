<%= form_with model: draft, class: "grid grid-cols-[minmax(0,1fr)_24rem] items-start gap-8", data: { controller: "composer" } do %>
  <div class="flex flex-col gap-4">
    <% unless draft.persisted? %><%= hidden_field_tag :open, "1" %><% end %>
    <% if draft.errors.any? %><%= lc_alert draft.errors.full_messages.to_sentence, tone: :destructive %><% end %>
    <%= lc_card do %>
      <div class="flex flex-col gap-4">
        <%= lc_textarea draft.body, name: "draft[body]", rows: 12, autofocus: true, placeholder: "Write your post. Add a line with --- to split it into a thread.", aria: { label: "Draft" }, class: "text-base", data: { composer_target: "input", action: "input->composer#render" } %>
        <div class="flex flex-wrap items-center gap-2">
          <%= lc_button "Save", type: :submit, size: :sm, icon: "check" %>
          <%= lc_button "Add thread break", type: :button, variant: :ghost, size: :sm, icon: "plus", data: { action: "composer#insertBreak" } %>
          <span class="ms-auto text-sm text-muted-foreground" data-composer-target="summary"></span>
        </div>
      </div>
    <% end %>
    <div class="grid grid-cols-2 gap-4">
      <%= lc_field label: "Topic", id: "draft-topic" do |field| %>
        <%= lc_input name: "draft[topic]", value: draft.topic, list: "draft-topics", **field %>
        <datalist id="draft-topics"><% Current.workspace.interests.each do |interest| %><option value="<%= interest %>"></option><% end %></datalist>
      <% end %>
      <%= lc_field label: "Stage", id: "draft-status" do |field| %>
        <%= lc_select Draft::STATUSES.map { |key, label| [label, key] }, name: "draft[status]", selected: draft.status, **field %>
      <% end %>
    </div>
    <%= lc_field label: "Notes", id: "draft-notes", hint: "Angles, sources, who might care. Never posted." do |field| %>
      <%= lc_textarea draft.notes, name: "draft[notes]", rows: 4, **field %>
    <% end %>
    <% if draft.inspiration_url.present? %>
      <%= hidden_field_tag "draft[inspiration_url]", draft.inspiration_url %>
      <p class="text-xs text-muted-foreground">Inspired by <%= link_to "this post", draft.inspiration_url, target: "_blank", rel: "noopener noreferrer", class: "text-primary hover:underline" %>.</p>
    <% end %>
  </div>

  <aside class="sticky top-6 flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <%= lc_heading "Preview", level: 2, size: :subheading %>
      <span class="text-xs text-muted-foreground">Approximate X count</span>
    </div>
    <div class="flex flex-col gap-3" data-composer-target="preview"></div>
    <% if draft.persisted? && !demo? %>
      <%= lc_card do %>
        <div class="flex flex-col gap-3">
          <% if draft.posted_url %>
            <%= lc_text "Posted #{draft.posted_at&.strftime('%-d %b %Y, %H:%M')}.", size: :small %>
            <%= lc_button_link_to "View on X", draft.posted_url, target: "_blank", rel: "noopener noreferrer", variant: :secondary, size: :sm, icon: "arrow-up-right" %>
          <% else %>
            <%= lc_button_link_to "Open in X composer", draft.intent_url, target: "_blank", rel: "noopener noreferrer", variant: :secondary, size: :sm, icon: "arrow-up-right", data: { composer_target: "intent" } %>
            <%= lc_text "Opens X with the first post filled in. You review and post it there; threads continue manually. After posting, mark it Posted — Check sent replies links it to the tweet.", size: :caption, tone: :muted %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </aside>
<% end %>
