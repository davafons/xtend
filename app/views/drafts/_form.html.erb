<%# The composer and the draft's details share one form; details sit in the side column via the form attribute. %>
<%= form_with model: draft, id: "draft-form" do %>
  <% unless draft.persisted? %><%= hidden_field_tag :open, "1" %><% end %>
  <% if draft.inspiration_url.present? %><%= hidden_field_tag "draft[inspiration_url]", draft.inspiration_url %><% end %>
<% end %>
<% if draft.errors.any? %><%= lc_alert draft.errors.full_messages.to_sentence, tone: :destructive %><% end %>
<%= lc_card do %>
  <%= render "drafts/composer", parts: draft.parts, form: "draft-form", intent: draft.persisted? && !draft.posted_url && !demo? %>
<% end %>
