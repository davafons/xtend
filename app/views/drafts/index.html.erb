<% content_for :title, "Compose" %>
<h1 class="sr-only">Compose</h1>
<% name, handle = owner_identity %>

<div class="grid items-start gap-section lg:grid-cols-[minmax(0,1fr)_20rem]">
  <div class="flex flex-col">
    <%= compose_tabs counts: @counts, status: @status %>

    <%= form_with model: @draft, class: "border-b border-border px-content pt-content pb-heading" do %>
      <%= render "drafts/composer", parts: [], submit: "Save idea", required: true %>
    <% end %>

    <% if @drafts.empty? %>
      <div class="flex flex-col items-center gap-related px-content py-section text-center">
        <%= lc_icon_badge icon: "light-bulb", shape: :circle, size: :lg %>
        <%= lc_heading(@status ? "Nothing in #{Draft::STATUSES[@status]}" : "No ideas yet", level: 2, size: :subheading) %>
        <%= lc_text "Write one above, or ask your Grok bot to save an idea with a few versions.", size: :small, tone: :muted %>
      </div>
    <% else %>
      <ol class="flex flex-col divide-y divide-border">
        <% @drafts.each do |draft| %>
          <% extra = capture do %>
            <% if draft.source == "grok" %><%= grok_badge %><% end %>
            <% unless @status %><%= lc_badge Draft::STATUSES.fetch(draft.status) %><% end %>
          <% end %>
          <%= render layout: "drafts/post", locals: { avatar: owner_avatar(size: 11), name: name, handle: handle, time: x_post_time(draft.posted_at || draft.updated_at), extra: extra.presence, id: dom_id(draft) } do %>
            <%= link_to edit_draft_path(draft), class: "flex flex-col gap-tight hover:opacity-80" do %>
              <% if draft.parts.any? %>
                <span class="line-clamp-6 whitespace-pre-line break-words"><%= draft.parts.first %></span>
                <% if draft.thread? %><span class="text-you">Show this thread · <%= draft.parts.size %> posts</span><% end %>
              <% else %>
                <span class="text-muted-foreground"><%= draft.topic.presence || draft.notes.to_s.truncate(200) %></span>
              <% end %>
            <% end %>
            <div class="mt-related flex items-center gap-section text-small text-muted-foreground">
              <% if draft.alternatives.any? %>
                <span class="inline-flex items-center gap-tight" title="<%= pluralize(draft.alternatives.size, "other version") %>"><%= lc_icon "square-2-stack", options: { class: "size-[18px]", "aria-hidden": true } %><span class="sr-only">Other versions:</span><%= draft.alternatives.size %></span>
              <% end %>
              <% if draft.over_limit? %>
                <span class="inline-flex items-center gap-tight text-destructive"><%= lc_icon "exclamation-triangle", options: { class: "size-[18px]", "aria-hidden": true } %>Too long</span>
              <% end %>
              <% if draft.topic.present? && draft.parts.any? %><span class="min-w-0 truncate"><%= draft.topic %></span><% end %>
              <span class="ms-auto">
                <% if draft.posted_url && !demo? %>
                  <%= lc_icon_button_link_to "View on X", draft.posted_url, icon: "arrow-up-right", size: :sm, target: "_blank", rel: "noopener noreferrer", title: "View on X" %>
                <% elsif (following = draft.next_status) %>
                  <% label = following == "posted" ? "I posted it" : "Move to #{Draft::STATUSES[following]}" %>
                  <%= lc_button_to draft_path(draft), method: :patch, params: { draft: { status: following }, return_to: "board" }, variant: :ghost, size: :sm, icon: (following == "posted" ? "check" : "arrow-right"), icon_position: :end do %><%= label %><% end %>
                <% end %>
              </span>
            </div>
          <% end %>
        <% end %>
      </ol>
    <% end %>
  </div>

  <%= render "drafts/sidebar", ideas: Draft::Ideas.new %>
</div>
