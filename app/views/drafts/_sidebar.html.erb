<%# The right column of the list views: quick ideas from focus areas, and the AI prompt. %>
<%# locals: (ideas:) %>
<aside class="sticky top-6 flex flex-col gap-content">
  <%= lc_card do %>
    <div class="flex flex-col gap-heading">
      <div class="flex items-center justify-between gap-heading">
        <%= lc_heading "Focus areas", level: 2, size: :subheading %>
        <%= lc_icon_button_link_to "Edit focus areas", settings_path, icon: "pencil", size: :sm, title: "Edit focus areas" %>
      </div>
      <% if ideas.interests.any? %>
        <ul class="-mx-related flex flex-col">
          <% ideas.interests.each do |interest| %>
            <li class="flex items-center justify-between gap-heading rounded-xl px-related py-tight hover:bg-tile">
              <span class="text-small"><%= interest %></span>
              <%= lc_icon_button_to "Save an idea about #{interest}", drafts_path, params: { draft: { topic: interest, status: "idea" } }, icon: "light-bulb", size: :sm, title: "Save an idea about this" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= lc_text "None set yet.", size: :small, tone: :muted %>
      <% end %>
    </div>
  <% end %>
  <%= lc_card do %>
    <div class="flex flex-col gap-heading">
      <%= lc_heading "Angles from AI", level: 2, size: :subheading %>
      <%= lc_text "Your connected AI reads your focus areas, what worked, and your network's posts, and saves ideas here.", size: :small, tone: :muted %>
      <%= ai_task_copy :post_ideas %>
    </div>
  <% end %>
</aside>
