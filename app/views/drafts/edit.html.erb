<% content_for :title, @draft.title.to_s.truncate(40).presence || "Draft" %>
<div class="flex items-end justify-between gap-8 pb-6 pt-8">
  <div class="flex flex-col gap-2">
    <%= lc_button_link_to "Board", drafts_path, variant: :ghost, size: :sm, icon: "arrow-left", class: "self-start" %>
    <%= lc_heading "Draft", level: 1, size: :page %>
    <p class="text-sm text-muted"><%= Draft::STATUSES.fetch(@draft.status) %> · edited <%= time_ago_in_words(@draft.updated_at) %> ago</p>
  </div>
  <div class="flex items-center gap-2">
    <%= render "tabs" %>
    <%= lc_button_to "Delete", draft_path(@draft), method: :delete, variant: :ghost, size: :sm, icon: "trash", data: { turbo_confirm: "Delete this draft?" } %>
  </div>
</div>
<%= render "form", draft: @draft %>
