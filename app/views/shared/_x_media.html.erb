<%# A post's photos, videos, and GIFs as x.com lays them out: one at its own shape, two to four in a grid.
    Images and videos load from X's own hosts. A video without an MP4 shows its poster and opens on X. %>
<%# locals: (media:, url: nil) -%>
<% single = media.size == 1 %>
<% grid = "grid aspect-video grid-cols-2 gap-0.5 #{media.size == 2 ? 'grid-rows-1' : 'grid-rows-2'}" %>
<div class="mt-3 overflow-hidden rounded-2xl bg-tile <%= single ? 'w-fit max-w-full' : grid %>" data-post-link-ignore>
  <% media.each_with_index do |item, index| %>
    <% image = item["image"] %>
    <% size = { width: item["width"], height: item["height"] }.compact %>
    <% fit = single ? "block max-h-[32rem] w-auto max-w-full" : "size-full object-cover" %>
    <div class="relative min-h-0 min-w-0 <%= 'row-span-2' if media.size == 3 && index.zero? %>">
      <% if item["kind"] == "photo" %>
        <%= link_to x_media_image_url(image, "large"), target: "_blank", rel: "noopener noreferrer", class: "block size-full", title: "Open the full image" do %>
          <%= image_tag x_media_image_url(image, single ? "medium" : "small"), alt: item["alt"].to_s, loading: "lazy", referrerpolicy: "no-referrer", class: fit, **size %>
        <% end %>
      <% else %>
        <% gif = item["kind"] == "animated_gif" %>
        <% if item["video"] %>
          <%= tag.video src: item["video"], poster: x_media_image_url(image, single ? "medium" : "small"), playsinline: true, referrerpolicy: "no-referrer",
            aria: { label: item["alt"].presence || (gif ? "GIF" : "Video") }, class: "#{fit} bg-black", **size,
            **(gif ? { autoplay: true, loop: true, muted: true, preload: "auto" } : { controls: true, preload: "none" }) %>
          <% if gif %><span class="pointer-events-none absolute bottom-2 left-2 rounded bg-black/70 px-1 text-caption font-bold text-white">GIF</span><% end %>
        <% else %>
          <%= link_to url || x_media_image_url(image, "large"), target: "_blank", rel: "noopener noreferrer", class: "relative block size-full", title: "Play on X" do %>
            <%= image_tag x_media_image_url(image, single ? "medium" : "small"), alt: item["alt"].to_s, loading: "lazy", referrerpolicy: "no-referrer", class: fit, **size %>
            <span class="absolute inset-0 flex items-center justify-center"><span class="flex size-12 items-center justify-center rounded-full bg-primary text-primary-foreground"><%= lc_icon "play", variant: :solid, options: { class: "size-6", "aria-hidden": true } %></span></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
