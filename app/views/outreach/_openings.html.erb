<%# Fresh posts worth a reply, each with why it is here. Replying happens on X. %>
<%# locals: (prospects:, openings:) -%>
<% if openings.to_a.empty? %>
  <%= lc_empty_state title: "No fresh posts to answer.", text: "Nothing unanswered in the last two days of collected posts from your people or discovery. Older posts aren't shown as current.", icon: "chat-bubble-oval-left", card: true %>
<% else %>
  <%= lc_card padding: :none, class: "overflow-hidden" do %>
    <ol class="flex flex-col divide-y divide-border">
      <% openings.to_a.each do |opening| %>
        <% post = opening.post %>
        <% author = opening.author %>
        <% captured = post.is_a?(X::SourcePost) %>
        <%
          why = []
          why += opening.prospect.reasons.first(2).map { |reason| outreach_reason(reason) } if opening.prospect
          if opening.discovery&.match_reason.present?
            why << tag.span(class: "inline-flex min-w-0 items-center gap-tight", title: opening.discovery.match_reason) do
              safe_join([ lc_icon("light-bulb", options: { class: "size-4 shrink-0", "aria-hidden": true }), tag.span(opening.discovery.match_reason, class: "truncate") ])
            end
          end
          note = ("Counts as of #{post.metrics_observed_at.strftime('%-d %b, %H:%M')}" if captured && post.metrics_observed_at)
        %>
        <li class="px-inset py-3" id="opening_<%= opening.x_id %>">
          <%= render "shared/x_post",
            avatar: outreach_avatar(author, prospects.graph),
            name: author.name, name_url: (author if author.is_a?(Person)), handle: author.handle, at: post.published_at,
            context: (tag.span(safe_join(why), class: "flex min-w-0 flex-wrap items-center gap-x-heading text-small") if why.any?),
            body: CGI.unescapeHTML(post.body),
            media_kinds: captured ? post.media_kinds.to_s.split(",") : [],
            counts: captured ? { reply: post.reply_count, repost: post.repost_count, like: post.like_count, view: post.view_count, bookmark: post.bookmark_count } : { reply: post.reply_count },
            counts_note: note, url: opening.url %>
        </li>
      <% end %>
    </ol>
  <% end %>
<% end %>
