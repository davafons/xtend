<%# Posts worth a reply, each with why it is here. Replying happens on X.
    By default, today's share: the session's remaining replies, split into your circle and reach. all: every opening. %>
<%# locals: (prospects:, openings:, today:, all: false) -%>
<% if !all && today.remaining.zero? %>
  <%= lc_empty_state title: "Done for today.", text: "#{Outreach::Session::TARGET} new targets replied to this session. More replies still help; they just don't count toward today.", icon: "check-circle", card: true do %>
    <%= lc_button_link_to "Keep going", outreach_path(all: 1), variant: :secondary, size: :sm %>
  <% end %>
<% elsif all ? openings.to_a.empty? : today.empty? %>
  <%= lc_empty_state title: "No fresh posts to answer.", text: "Nothing unanswered in the last two days of collected posts from your people or discovery. Older posts aren't shown as current.", icon: "chat-bubble-oval-left", card: true %>
<% elsif !all %>
  <% groups = [
    [ "Circle", today.circle, "People on your Circle lists. Being seen by the same people again and again is what turns replies into follows." ],
    [ "Reach", today.reach, "Everyone else worth a reply: discovery picks and people around your network. Their readers find you here." ]
  ].select { |_, list, _| list.any? } %>
  <div class="flex flex-wrap items-baseline justify-between gap-x-heading gap-y-tight">
    <p class="text-small text-muted-foreground"><span class="font-semibold text-foreground"><%= pluralize(today.size, "post") %> for the <%= today.remaining %> <%= "reply".pluralize(today.remaining) %> left today</span> · <%= today.circle.size %> circle, <%= today.reach.size %> reach</p>
    <%= link_to "See the whole list", outreach_path(all: 1), class: "text-small text-primary hover:underline" %>
  </div>
  <% groups.each do |label, list, about| %>
    <section class="flex flex-col gap-related" aria-label="<%= label %>">
      <div>
        <h2 class="text-label"><%= label %> <span class="font-normal tabular-nums text-muted-foreground"><%= list.size %></span></h2>
        <p class="text-caption text-muted-foreground"><%= about %></p>
      </div>
      <%= lc_card padding: :none, class: "overflow-hidden" do %>
        <ol class="flex flex-col divide-y divide-border">
          <% list.each do |opening| %><%= render "outreach/opening", opening: opening, prospects: prospects %><% end %>
        </ol>
      <% end %>
    </section>
  <% end %>
<% else %>
  <div class="flex justify-end"><%= link_to (today.remaining.zero? ? "Today's done: back to the summary" : "Show today's #{today.remaining}"), outreach_path, class: "text-small text-primary hover:underline" %></div>
  <%= lc_card padding: :none, class: "overflow-hidden" do %>
    <ol class="flex flex-col divide-y divide-border">
      <% openings.to_a.each do |opening| %><%= render "outreach/opening", opening: opening, prospects: prospects %><% end %>
    </ol>
  <% end %>
<% end %>
