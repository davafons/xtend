<%# What the suggestions are built from. Anything not collected is a gap, not a zero. %>
<%# locals: (graph:) -%>
<% day = ->(snapshot) { snapshot&.observed_at ? snapshot.observed_at.strftime("%-d %b") : "not checked" } %>
<section class="flex flex-col gap-heading" aria-labelledby="outreach-coverage">
  <h2 id="outreach-coverage" class="text-eyebrow text-muted-foreground">Based on</h2>
  <dl class="flex flex-col gap-tight text-caption">
    <% Person::Interactions.coverage.merge("Following" => day.(graph.following), "Followers" => day.(graph.followers)).each do |label, value| %>
      <div class="flex justify-between gap-related">
        <dt class="text-muted-foreground"><%= label %></dt>
        <dd class="m-0 text-end"><%= value %></dd>
      </div>
    <% end %>
  </dl>
  <p class="text-caption text-muted-foreground">Nothing seen is not proof of nothing said.</p>
</section>
