<% batch = AI::Classification.batch %>
<% pending = AI::Proposal.pending.where(kind: "tags").includes(person: :tags).order(:created_at) %>
<div id="tags" class="<%= lc_stack_class(gap: :section, extra: "scroll-mt-section") %>">
  <% if pending.any? %>
    <%= lc_list_section "To review" do %>
      <%= lc_list_group do %>
        <%= lc_list_row "#{pluralize(pending.size, "person", plural: "people")} with suggested tags", icon: lc_icon("sparkles", options: { class: "text-ai", "aria-hidden": true }) do %>
          <%= lc_button_to "Accept all", review_ai_proposals_path, method: :patch, params: { decision: "accept" }, variant: :secondary, size: :sm %>
          <%= lc_button_to "Dismiss all", review_ai_proposals_path, method: :patch, params: { decision: "dismiss" }, variant: :ghost, size: :sm %>
        <% end %>
        <% pending.each do |proposal| %>
          <%= lc_list_row do %>
            <div class="flex items-center gap-heading">
              <%= person_avatar proposal.person, size: :sm %>
              <div class="min-w-0 grow">
                <p class="text-small"><%= link_to proposal.person.name, proposal.person, class: "font-semibold hover:underline" %> <span class="text-muted-foreground">@<%= proposal.person.handle %></span></p>
                <div class="mt-tight flex flex-wrap gap-tight">
                  <% proposal.person.tags.each do |tag| %><%= tag_chip tag.name %><% end %>
                  <% proposal.payload["tags"].each do |name| %><%= tag_chip name %><% end %>
                </div>
                <% if proposal.payload["reason"] %><p class="mt-tight truncate text-caption text-muted-foreground" title="<%= proposal.payload["reason"] %>"><%= proposal.payload["reason"] %></p><% end %>
              </div>
              <%= lc_icon_button_to "Accept tags for #{proposal.person.name}", ai_proposal_path(proposal), method: :patch, params: { decision: "accept" }, icon: "check", size: :sm, title: "Accept" %>
              <%= lc_icon_button_to "Dismiss tags for #{proposal.person.name}", ai_proposal_path(proposal), method: :patch, params: { decision: "dismiss" }, icon: "x-mark", size: :sm, title: "Dismiss" %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= lc_list_section "Tag people with AI", footnote: "Your assistant suggests tags such as a city, role, or topic. Paste the prompt into Grok or any AI, or let a connected assistant tag people directly. Tags apply only when you accept them; your own tags never change." do %>
    <%= lc_list_group do %>
      <% if batch.any? %>
        <%= lc_list_row "Tagging prompt", icon: "clipboard-document", subtitle: "#{pluralize(batch.size, "untagged person", plural: "untagged people")}, followers first · copy again after each import" do %>
          <%= lc_copy_button "Copy", value: AI::Classification.prompt(batch), variant: :secondary, size: :sm, aria: { label: "Copy tagging prompt" } %>
        <% end %>
        <%= lc_list_row padded: false do %>
          <%= lc_collapsible card: false, indicator: :chevron, summary_class: "px-content sm:px-inset text-small font-normal text-muted-foreground" do |collapsible| %>
            <% collapsible.summary do %><span class="me-auto">Read the prompt</span><% end %>
            <p class="mx-content mb-content whitespace-pre-wrap rounded-2xl bg-tile p-content text-caption sm:mx-inset"><%= AI::Classification.prompt(batch) %></p>
          <% end %>
        <% end %>
      <% else %>
        <%= lc_list_row "Tagging prompt", icon: "clipboard-document", subtitle: "Everyone with an X account in your CRM has tags." %>
      <% end %>
    <% end %>
  <% end %>

  <%= lc_list_section "AI results", footnote: "Paste the assistant's whole answer. Only its JSON block is read, up to #{AI::Intake::MAX_TAG_ITEMS} people." do %>
    <%= form_with url: ai_intakes_path do %>
      <%= hidden_field_tag :return_to, "ai" %>
      <%= lc_list_group do %>
        <%= lc_list_row do %>
          <%= lc_textarea "", name: "ai_output", rows: 4, maxlength: 100_000, required: true, id: "ai-tags-output", placeholder: "Paste the answer", aria: { label: "AI results" } %>
          <div class="mt-related flex justify-end"><%= lc_button "Import", type: :submit, variant: :secondary, size: :sm, aria: { label: "Import tag suggestions" } %></div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
