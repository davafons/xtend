<% content_for :title, "Network" %>
<% kind_labels = { "reply" => "Replies", "quote" => "Quotes", "repost" => "Reposts", "mention" => "Mentions", "like" => "Likes", "follow" => "Follows" } %>
<% kind_icons = { "reply" => "chat-bubble-oval-left", "quote" => "chat-bubble-bottom-center-text", "repost" => "arrow-path-rounded-square", "mention" => "at-symbol", "like" => "heart", "follow" => "user-plus" } %>
<h1 class="sr-only">Network</h1>

<%= form_with url: network_path, method: :get, class: "flex flex-wrap items-center gap-related", data: { controller: "auto-submit", turbo_action: "replace" } do %>
  <%= lc_select Network::Graph::PERIODS.keys.map { |key| [ { "30d" => "Last 30 days", "90d" => "Last 90 days", "1y" => "Last year", "all" => "All time" }.fetch(key), key ] }, name: "period", selected: @graph.period, size: :sm, aria: { label: "Period" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
  <%= lc_select Network::Graph::SCOPES.map { |key, label| [ label, key ] }, name: "scope", selected: @graph.scope, size: :sm, aria: { label: "Who" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
  <% if @tags.any? %>
    <%= lc_select [ [ "Any tag", "" ], *@tags.map { |tag| [ "##{tag.name}", tag.name ] } ], name: "tag", selected: @graph.tag, size: :sm, aria: { label: "Tag" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
  <% end %>
  <fieldset class="ms-auto flex flex-wrap items-center gap-tight">
    <legend class="sr-only">Interactions to show</legend>
    <% Network::Graph::KINDS.each do |kind| %>
      <%= lc_toggle kind_labels.fetch(kind), icon: kind_icons.fetch(kind), icon_only: true, tooltip: true, name: "kinds[]", value: kind, active: @graph.kinds.include?(kind), size: :sm, input: { type: "checkbox", data: { action: "auto-submit#submit" } } %>
    <% end %>
  </fieldset>
  <div class="flex items-center gap-tight">
    <%= hidden_field_tag "me", "0", id: nil %><%= lc_toggle "You", name: "me", value: "1", active: @graph.include_owner, size: :sm, title: "Include your own interactions", input: { type: "checkbox", data: { action: "auto-submit#submit" } } %>
    <%= hidden_field_tag "outside", "0", id: nil %><%= lc_toggle "Outside your CRM", name: "outside", value: "1", active: @graph.outside, size: :sm, title: "Accounts not in your CRM that at least two of your people interact with", input: { type: "checkbox", data: { action: "auto-submit#submit" } } %>
  </div>
<% end %>

<% if @coverage.empty? %>
  <%= lc_empty_state title: "No interactions collected yet.", text: "Browse x.com with the capture extension on; threads, timelines, and follow lists you open fill this in for free.", icon: "share", card: true do %>
    <%= lc_button_link_to "Set up browser capture", x_sources_path(anchor: "capture"), variant: :secondary %>
  <% end %>
<% else %>
  <div class="flex flex-col gap-inset" data-live="manual" data-controller="network" data-network-url-value="<%= network_path(request.query_parameters.merge(format: :json)) %>">
    <%= lc_card padding: :none, class: "relative overflow-hidden" do %>
      <div class="relative h-[calc(100dvh-10rem)] min-h-[32rem]">
        <canvas class="absolute inset-0 size-full cursor-grab touch-none" title="Scroll to zoom, drag to move, select someone to see their connections" data-network-target="canvas" role="img" aria-label="Network graph of <%= pluralize(@graph.nodes.size, "account") %> and <%= pluralize(@graph.links.size, "connection") %>"></canvas>
        <div class="pointer-events-none absolute start-4 top-4 rounded-lg bg-tile px-related py-tight text-small font-medium" data-network-target="tooltip" hidden></div>
        <%= lc_card padding: :sm, class: "absolute end-4 top-4 max-h-[calc(100%-2rem)] w-80 overflow-y-auto bg-card/85 backdrop-blur" do %>
          <div class="flex flex-col gap-heading" data-network-target="panel">
            <h2 class="<%= lc_text_class(size: :label) %>">Connections</h2>
            <%= lc_text "Select someone in the graph.", size: :small, tone: :muted %>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= lc_card do %>
        <div class="grid gap-section text-small md:grid-cols-2">
          <section class="flex flex-col gap-related" aria-labelledby="network-key">
            <h2 id="network-key" class="text-caption text-muted-foreground">Key</h2>
            <ul class="grid grid-cols-2 gap-x-related gap-y-tight">
              <li class="flex items-center gap-related"><span class="size-3 shrink-0 rounded-full ring-2 ring-success"></span>Mutual</li>
              <li class="flex items-center gap-related"><span class="size-3 shrink-0 rounded-full ring-2 ring-you"></span>You follow</li>
              <li class="flex items-center gap-related"><span class="size-3 shrink-0 rounded-full ring-2 ring-warning"></span>Follows you</li>
              <li class="flex items-center gap-related"><span class="size-3 shrink-0 rounded-full ring-2 ring-muted-foreground"></span>Outside CRM</li>
              <li class="flex items-center gap-related"><span class="h-0.5 w-4 shrink-0 bg-you"></span>Yours</li>
              <li class="flex items-center gap-related"><span class="h-0.5 w-4 shrink-0 bg-like"></span>Likes</li>
              <li class="flex items-center gap-related" title="Replies, quotes, reposts, mentions"><span class="h-0.5 w-4 shrink-0 bg-foreground/40"></span>Other</li>
              <li class="flex items-center gap-related"><span class="w-4 shrink-0 border-t-2 border-dashed border-foreground/40"></span>Follows only</li>
              <li class="col-span-2 flex items-center gap-related"><%= lc_icon "arrow-long-right", options: { class: "size-4 shrink-0 text-muted-foreground", "aria-hidden": true } %>From who acted</li>
            </ul>
          </section>
          <section class="flex flex-col gap-related" aria-labelledby="network-collected">
            <h2 id="network-collected" class="text-caption text-muted-foreground" title="<%= @coverage.last_capture_at ? "Last browser capture #{time_ago_in_words(@coverage.last_capture_at)} ago" : "No browser capture yet" %>">Collected</h2>
            <dl class="grid grid-cols-[1fr_auto] gap-x-content gap-y-tight tabular-nums">
              <% X::Interaction::KINDS.each do |kind| %>
                <dt class="text-muted-foreground"><%= kind_labels.fetch(kind) %></dt><dd class="text-end"><%= number_with_delimiter(@coverage.interactions_by_kind.fetch(kind, 0)) %></dd>
              <% end %>
              <dt class="text-muted-foreground">Follow edges</dt><dd class="text-end"><%= number_with_delimiter(@coverage.follow_edges) %></dd>
              <dt class="text-muted-foreground">Accounts seen</dt><dd class="text-end"><%= number_with_delimiter(@coverage.accounts) %></dd>
              <dt class="text-muted-foreground">Posts saved</dt><dd class="text-end"><%= number_with_delimiter(@coverage.posts) %></dd>
            </dl>
            <% if @graph.isolated_count.positive? %><p class="text-caption text-muted-foreground"><%= pluralize(@graph.isolated_count, "person") %> here <%= @graph.isolated_count == 1 ? "has" : "have" %> no connection yet.</p><% end %>
          </section>
        </div>
    <% end %>
  </div>

  <% top = @graph.nodes.reject { |node| node[:owner] }.sort_by { |node| -node[:weight] }.first(12) %>
  <% if top.any? %>
    <section class="flex flex-col gap-related" aria-labelledby="most-connected">
      <h2 id="most-connected" class="<%= lc_text_class(size: :small, tone: :muted) %>">Most connected in this view</h2>
      <%= lc_card padding: :none do %>
        <ol class="grid grid-cols-2 divide-y divide-border xl:grid-cols-3">
          <% top.each do |node| %>
            <li class="flex items-center gap-heading px-inset py-heading">
              <% if node[:avatar] && !demo? %><%= lc_avatar src: node[:avatar], alt: "", size: :md, referrerpolicy: "no-referrer", loading: "lazy" %><% else %><%= lc_avatar node[:name].to_s.first(2).upcase %><% end %>
              <span class="min-w-0 grow">
                <% if node[:person_id] %><%= link_to node[:name], person_path(node[:person_id]), class: "block truncate font-semibold hover:underline" %><% else %><span class="block truncate font-semibold"><%= node[:name] %></span><% end %>
                <span class="block truncate text-caption text-muted-foreground">@<%= node[:handle] %><%= " | outside your CRM" if node[:outside] %></span>
              </span>
              <span class="text-small tabular-nums text-muted-foreground" title="Interactions in this view"><%= node[:weight] %></span>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>
  <% end %>
<% end %>
