<section id="discovery" class="flex flex-col gap-4 scroll-mt-8">
  <%= lc_heading "Find conversations with Grok", level: 2, size: :heading %>
  <%= lc_card do %>
    <div class="flex flex-col gap-5">
      <%= lc_text "Use your Grok Bot's public search, then paste its JSON block here. Grok's public search uses no X API credits, and its candidates go straight to Today labeled Unverified, with no paid lookup.", tone: :muted %>
      <%= lc_button_to "Refresh saved matches", refresh_discovery_suggestions_path, variant: :ghost, size: :sm, icon: "funnel" %>
      <%= lc_copy_button "Copy discovery prompt", value: Discovery::Suggestion.grok_prompt, variant: :secondary, size: :sm %>
      <%= lc_collapsible title: "Read the prompt" do %><p class="whitespace-pre-wrap text-sm pt-4"><%= Discovery::Suggestion.grok_prompt %></p><% end %>
      <%= form_with url: grok_intakes_path, class: "flex flex-col gap-4" do %>
        <%= lc_field label: "Grok results", id: "grok-output", hint: "Paste Grok's whole answer. The app reads only its #{Grok::Intake::FORMAT} JSON block: up to 20 posts, profiles, and recaps." do |field| %><%= lc_textarea "", name: "grok_output", rows: 6, maxlength: 100_000, required: true, **field %><% end %>
        <div><%= lc_button "Import Grok results", type: :submit, size: :sm, icon: "arrow-down-tray" %></div>
      <% end %>
      <% unverified = Post.opportunities.where(source: "grok").count %>
      <% if unverified.positive? %><p class="text-sm"><%= pluralize(unverified, "unverified Grok candidate") %> waiting in Today.</p><% end %>
      <%= lc_collapsible title: "Paste bare links instead (paid lookup)" do %>
      <%= form_with url: discovery_suggestions_path, class: "flex flex-col gap-4 pt-4" do %>
        <%= lc_field label: "X source links", id: "discovery-links", hint: "Up to 20 post URLs, one per line. Numeric author IDs are not required." do |field| %><%= lc_textarea "", name: "links", rows: 4, maxlength: 20000, required: true, **field %><% end %>
        <div><%= lc_button "Save source links", type: :submit, variant: :secondary, size: :sm, icon: "link" %></div>
      <% end %>
      <% pending = Discovery::Suggestion.unresolved.count %>
      <% if pending.positive? %>
        <p class="text-sm"><%= pending %> source links need post verification.</p>
        <%= lc_button_to "Resolve saved links", x_sync_runs_path, params: {dataset: "posts", purpose: "discovery", request_key: SecureRandom.uuid, return_to: "discovery"}, variant: :secondary, size: :sm, disabled: demo? || !@cycle || !X::Connection.current %>
        <p class="text-xs text-muted-foreground">Up to 20 posts ($0.10 standard maximum), then resolve missing people separately if needed.</p>
      <% end %>
      <% end %>
    </div>
  <% end %>
  <%= lc_collapsible title: "Try a small direct X search" do %>
    <%= lc_card class: "mt-4" do %>
      <%= form_with url: x_sync_runs_path, class: "flex flex-col gap-4" do %>
        <%= hidden_field_tag :dataset, "search" %>
        <%= hidden_field_tag :return_to, "discovery" %>
        <%= hidden_field_tag :request_key, SecureRandom.uuid %>
        <%= lc_field label: "Builder conversation search", id: "discovery-query", hint: "Up to 10 posts per click, $0.05 standard maximum. English and repost filters are added." do |field| %><%= lc_input name: "query", value: '("Ruby on Rails" OR SQLite OR "coding agents" OR "Claude Code") (question OR debugging OR tradeoff OR stuck OR learned) -crypto -airdrop -blockchain -web3', minlength: 3, maxlength: 256, required: true, **field %><% end %>
        <div><%= lc_button "Find 10 posts", type: :submit, variant: :secondary, size: :sm, icon: "magnifying-glass", disabled: demo? || !@cycle || !X::Connection.current %></div>
      <% end %>
    <% end %>
  <% end %>
</section>
