<% workspace = Current.workspace %>
<% value = ->(text) { tag.span(text, class: "text-small text-muted-foreground") } %>
<%= lc_list_section "Grok Bot connector (MCP)", id: "connector", class: "scroll-mt-section", footnote: "Lets an AI client read your CRM and stage replies, profile facts, and recaps for your review. It can't post, follow, message, or start paid X reads. Grok Bot runs in xAI's cloud and can't reach this local app yet; until then paste results above or test with a local MCP client." do %>
  <%= lc_list_group do %>
    <%= lc_list_row "Endpoint", icon: "link", subtitle: tag.span(mcp_url, class: "font-mono") do %>
      <%= lc_copy_button value: mcp_url, icon_only: true, variant: :ghost, size: :sm, aria: { label: "Copy endpoint" } %>
    <% end %>
    <%= lc_list_row "Token", icon: "key", subtitle: (workspace.mcp_token_digest ? "Created #{time_ago_in_words(workspace.mcp_token_created_at)} ago · #{workspace.mcp_token_used_at ? "last used #{time_ago_in_words(workspace.mcp_token_used_at)} ago" : "not used yet"}" : "None yet") do %>
      <% if workspace.mcp_token_digest %>
        <%= lc_badge "Token active", tone: :success %>
        <%= lc_icon_button_to "Replace token", mcp_token_path, icon: "arrow-path", size: :sm, title: "Replace token", data: { turbo: false } %>
        <%= lc_icon_button_to "Revoke token", mcp_token_path, method: :delete, icon: "no-symbol", size: :sm, tone: :destructive, title: "Revoke token" %>
      <% else %>
        <%= lc_button_to "Create token", mcp_token_path, variant: :secondary, size: :sm, data: { turbo: false }, aria: { label: "Create connector token" } %>
      <% end %>
    <% end %>
    <%= lc_list_row "Always shared", icon: "globe-alt", subtitle: "Interests, people, public profiles, follow and reply states, pins, keeps, collected public posts, likes, and bookmarks" %>
    <% [[:mcp_share_notes, "Private notes", "pencil-square", nil], [:mcp_share_dms, "DM metadata", "envelope", "Who and when, never text"]].each do |field, label, icon, subtitle| %>
      <% shared = workspace.public_send(field) %>
      <%= lc_list_row label, icon: icon, subtitle: subtitle do %>
        <%= value.(shared ? "Shared" : "Not shared") %>
        <%= lc_button_to shared ? "Stop sharing" : "Share", settings_path, method: :patch, params: { "workspace[#{field}]" => !shared }, variant: :secondary, size: :sm, aria: { label: "#{shared ? "Stop sharing" : "Share"} #{label.downcase}" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
