<% content_for :title, "Grok" %>
<div class="flex flex-col gap-3 pb-8 pt-8">
  <%= lc_heading "Grok Bot.", level: 1, size: :title %>
  <%= lc_text "The MCP connector, what it may share, and a context file for Grok conversations.", tone: :muted %>
</div>
<div class="grid grid-cols-2 items-start gap-8">
  <div class="flex flex-col gap-8">
    <%= render "tags" %>
    <%= render "connector" %>
  </div>
  <div class="flex flex-col gap-8">
      <%= lc_section title: "Grok Bot context" do %>
        <%= lc_card do %>
          <div class="flex flex-col gap-4">
            <%= lc_text "Download your interests, all saved people, public reply counts, follow states, tags, and pins for a Grok Bot conversation.", tone: :muted %>
            <%= lc_text "The file excludes private notes and DMs. Downloading does not send it anywhere. A live Bot connection is not configured.", size: :small, tone: :muted %>
            <div>
              <%= lc_button_link_to "Export public context", context_export_path, variant: :secondary, size: :sm, icon: "arrow-down-tray", data: { turbo: false } %>
            </div>
          </div>
        <% end %>
      <% end %>
  </div>
</div>
