<%# How to connect an MCP client. token is the real token right after creation, or a placeholder. %>
<% header = "Authorization: Bearer #{token}" %>
<% config = JSON.pretty_generate(mcpServers: { "twitter-crm" => { type: "http", url: mcp_url, headers: { Authorization: "Bearer #{token}" } } }) %>
<%= lc_tabs id: "mcp-setup", label: "Assistant" do |tabs| %>
  <% tabs.panel "Grok Bot", value: :grok do %>
    <div class="<%= lc_stack_class(gap: :content, extra: "pt-content") %>">
      <%= lc_text "Add a custom MCP server by URL on Grok Bot's computer, then send the token as a bearer header. Grok Bot runs in xAI's cloud, so it needs the deployed app's endpoint.", size: :small, tone: :muted %>
      <%= lc_code_block mcp_url, id: "mcp-setup-grok-url", title: "URL" %>
      <%= lc_code_block header, id: "mcp-setup-grok-header", title: "Header" %>
    </div>
  <% end %>
  <% tabs.panel "Claude", value: :claude do %>
    <div class="<%= lc_stack_class(gap: :content, extra: "pt-content") %>">
      <%= lc_code_block "claude mcp add --transport http twitter-crm #{mcp_url} --header \"#{header}\"", id: "mcp-setup-claude", language: :bash, title: "Claude Code" %>
    </div>
  <% end %>
  <% tabs.panel "Other", value: :other do %>
    <div class="<%= lc_stack_class(gap: :content, extra: "pt-content") %>">
      <%= lc_text "Any client that speaks MCP over Streamable HTTP and can send a bearer header.", size: :small, tone: :muted %>
      <%= lc_code_block config, id: "mcp-setup-json", language: :json, title: "mcp.json", max_lines: nil %>
    </div>
  <% end %>
<% end %>
