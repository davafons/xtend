<% content_for :title, "Sign in" %>
<h1 class="sr-only">Sign in</h1>
<div class="flex min-h-[80vh] items-center justify-center">
  <%= lc_card class: "w-full max-w-sm" do %>
    <div class="flex flex-col items-center gap-inset py-content text-center">
      <p class="crm-signature-text text-title font-bold">Xtend</p>
      <% if demo? %>
        <p class="text-small text-muted-foreground">Fictional demo workspace. It never calls X.</p>
        <%= lc_button_to "Open the demo workspace", session_path, form: { class: "w-full" }, class: "w-full" %>
      <% else %>
        <%= lc_button_to "Sign in with X", x_connection_path, icon: "arrow-right-end-on-rectangle", data: { turbo: false }, form: { class: "w-full" }, class: "w-full" %>
        <p class="text-caption text-muted-foreground">Read-only. Only allowed X accounts can sign in.</p>
      <% end %>
    </div>
  <% end %>
</div>
