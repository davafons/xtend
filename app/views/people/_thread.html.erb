<%# Posts that reply to each other, oldest first, joined by the thread line. %>
<% meaning = thread.authors.size > 1 ? :both : (thread.authors.first == :you ? :you : :them) %>
<p class="mb-1 grid grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-x-3 text-[0.8125rem] font-bold <%= ApplicationHelper::MEANING_TEXT.fetch(meaning) %>">
  <span class="flex justify-end"><%= lc_icon "chat-bubble-left-right", options: { class: "size-4", "aria-hidden": true } %></span>
  <span>Conversation | <%= pluralize(thread.posts.size, "reply", plural: "replies") %></span>
</p>
<% first = thread.posts.first %>
<% if first.parent && thread.posts.none? { |post| post.x_id == first.parent.x_id } %>
  <%= render "people/tweet", author: first.parent.author, person: person, owner_handle: owner_handle, body: first.parent.body,
    at: nil, url: ("https://x.com/i/status/#{first.parent.x_id}" if first.url), marks: timeline.marks[first.parent.x_id], thread: true, analytics: timeline.analytics_for(first.parent.x_id), source: timeline.sources[first.parent.x_id], **timeline.counts_for(first.parent.x_id) %>
<% end %>
<% thread.posts.each_with_index do |post, index| %>
  <%= render "people/tweet", author: post.author, person: person, owner_handle: owner_handle, body: post.body, at: post.at,
    url: post.url, marks: timeline.marks[post.x_id], detail: post.detail, thread: index < thread.posts.size - 1, analytics: timeline.analytics_for(post.x_id), source: timeline.sources[post.x_id], **timeline.counts_for(post.x_id) %>
<% end %>
