<% content_for :title, "People" %>
<h1 class="sr-only">People</h1>
<div class="flex flex-wrap items-center gap-related"><%= people_views :table %></div>
<%= form_with url: people_path, method: :get, class: "flex flex-wrap items-center gap-related", data: { controller: "auto-submit", turbo_action: "replace" } do %>
  <% if params[:sort].present? %><%= hidden_field_tag :sort, params[:sort] %><% end %>
  <%= lc_input name: "q", value: params[:q], type: :search, size: :sm, placeholder: "Search people and notes", aria: { label: "Search people" }, class: "w-72" %>
  <%= lc_select [["Any follow", ""], ["Mutuals", "mutual"], ["You follow only", "following_only"], ["They follow only", "followers_only"], ["Lost followers", "lost"]], name: "follow", selected: params[:follow], size: :sm, aria: { label: "Follow status" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
  <%= lc_select [["Any replies", ""], *["Two-way", "You replied only", "They replied only", "No observed replies"].map { |state| [state, state] }], name: "state", selected: params[:state], size: :sm, aria: { label: "Reply state" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
  <%= lc_select [["Everyone", ""], ["Pinned", "pinned"], ["Kept", "kept"], ["With notes", "notes"], ["Untagged", "untagged"]], name: "filter", selected: params[:filter], size: :sm, aria: { label: "Your markers" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
  <% if @lists.any? %>
    <%= lc_select [["Any list", ""], *@lists.map { |list| [list.name, list.id] }], name: "list", selected: @list&.id, size: :sm, aria: { label: "List" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
  <% end %>
  <% if @tags.any? %>
    <%= lc_select [["Any tag", ""], *@tags.map { |tag| ["##{tag.name} | #{tag.people_count}", tag.name] }], name: "tag", selected: params[:tag], size: :sm, aria: { label: "Tag" }, data: { action: "auto-submit#submit" }, class: "w-auto field-sizing-content" %>
  <% end %>
  <% if @talked %>
    <%= hidden_field_tag :from, params[:from] %>
    <%= hidden_field_tag :to, params[:to] %>
    <%= lc_button_link_to "Talked #{date_range_label(@talked)}", people_path(people_filter_params.except(:from, :to)), variant: :secondary, size: :sm, icon: "x-mark", icon_position: :end, aria: { label: "Remove the date filter: talked #{date_range_label(@talked)}" } %>
  <% end %>
  <%= lc_button "Search", type: :submit, variant: :secondary, class: "sr-only" %>
  <% if people_filter_params.except(:sort).any? %><%= lc_icon_button_link_to "Clear filters", people_path(people_filter_params.slice(:sort)), icon: "x-mark", size: :sm, title: "Clear filters" %><% end %>
  <div class="ms-auto">
    <%= lc_button_link_to "Add", new_person_path, icon: "plus", size: :sm, variant: :secondary, aria: { label: "Add a person" } %>
  </div>
<% end %>

<% if @recent.present? %>
  <nav id="recent-people" aria-label="Recent conversations" class="grid grid-cols-2 gap-content xl:grid-cols-4">
    <% @recent.each do |person| %>
      <%= lc_card href: person_path(person), padding: :sm do %>
        <span class="flex items-center gap-heading">
          <%= person_avatar person, ring: person.follow_state(@graph) %>
          <span class="min-w-0 grow">
            <span class="flex items-center gap-tight text-label">
              <span class="truncate"><%= person.name %></span>
              <% if person.pin %><%= lc_icon "bookmark", variant: :solid, options: { class: "size-3.5 shrink-0 text-you", "aria-label": "Pinned" } %><% end %>
            </span>
            <span class="block truncate text-caption text-muted-foreground" title="Last reply | @<%= person.handle %>"><%= relative_day person.last_interaction_at %></span>
          </span>
        </span>
      <% end %>
    <% end %>
  </nav>
<% end %>

<% if params[:follow].present? && !@graph.complete? %><%= lc_alert "Follow filters need complete follower and following checks.", tone: :warning %><% end %>

<% if @people.empty? %>
  <% if people_filter_params.except(:sort).any? %>
    <%= lc_empty_state title: "Nobody matches these filters.", icon: "funnel", card: true do %><%= lc_button_link_to "Clear filters", people_path, variant: :secondary, icon: "x-mark" %><% end %>
  <% else %>
    <%= lc_empty_state title: "Build your circle, one conversation at a time.", text: "People appear as your X archive, the browser extension, and follow checks bring them in.", icon: "users", card: true do %>
      <%= lc_button_link_to "Get started", start_path, icon: "rocket-launch" %>
      <%= lc_button_link_to "Add a person", new_person_path, variant: :secondary, icon: "plus" %>
    <% end %>
  <% end %>
<% else %>
  <% follow_source = "Follow status from saved checks: following #{@graph.following&.observed_at&.strftime("%-d %b, %H:%M") || "unknown"}, followers #{@graph.followers&.observed_at&.strftime("%-d %b, %H:%M") || "unknown"}" %>
  <%= lc_stack gap: :content do %>
    <%= lc_card padding: :none, class: "overflow-hidden" do %>
      <div class="overflow-x-auto" tabindex="0" role="region" aria-label="People">
        <%= lc_table do %>
          <caption class="sr-only">People, sorted by <%= { "name" => "name", "recent" => "most recent reply", "replies" => "most replies", "added" => "recently added", "followers" => "most followers" }.fetch(@sort) %></caption>
          <thead>
            <tr>
              <th scope="col"><%= people_sort_header "Person", "name" %></th>
              <th scope="col" class="max-lg:hidden"><span class="sr-only">Bio, notes and tags</span></th>
              <th scope="col" class="text-end"><%= people_sort_header "Followers", "followers" %></th>
              <th scope="col" class="text-center" title="<%= follow_source %>">Follow</th>
              <th scope="col"><%= people_sort_header "Replies", "replies" %></th>
              <th scope="col" class="text-end"><%= people_sort_header "Last reply", "recent" %></th>
            </tr>
          </thead>
          <tbody>
            <% @people.each do |person| %>
              <% follow = person.follow_state(@graph) %>
              <tr>
                <th scope="row" class="font-normal"><%= render "people/identity", person: person, ring: follow %></th>
                <td class="w-full max-w-0 max-lg:hidden">
                  <% summary = person.notes.presence || person.description.presence %>
                  <div class="flex min-w-0 items-center gap-related">
                    <% if (tier = person.tier_list) %><span class="shrink-0"><%= tier_badge tier %></span><% end %>
                    <% person.tags.each do |tag| %><span class="shrink-0"><%= tag_chip tag.name %></span><% end %>
                    <% if summary %><span class="min-w-0 truncate text-small <%= person.notes.present? ? "text-foreground" : "text-muted-foreground" %>" title="<%= summary %>"><%= summary %></span><% end %>
                  </div>
                </td>
                <td class="whitespace-nowrap text-end text-small tabular-nums"><%= compact_count person.followers_count %></td>
                <td class="text-center"><%= relationship_cue follow %></td>
                <td class="whitespace-nowrap text-small"><%= reply_counts person %></td>
                <td class="whitespace-nowrap text-end text-small text-muted-foreground"><%= relative_day person.last_interaction_at %></td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </div>
    <% end %>
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-content">
      <div><% if @page > 1 %><%= lc_icon_button_link_to "Previous page", people_path(people_filter_params(page: @page - 1)), icon: "arrow-left", variant: :secondary, size: :sm %><% end %></div>
      <p class="text-small tabular-nums text-muted-foreground">
        <% if @count.positive? %><%= (@page - 1) * PeopleController::PER_PAGE + 1 %>–<%= [@page * PeopleController::PER_PAGE, @count].min %> of <% end %><%= pluralize(@count, "person", plural: "people") %>
      </p>
      <div class="justify-self-end"><% if @page * PeopleController::PER_PAGE < @count %><%= lc_icon_button_link_to "Next page", people_path(people_filter_params(page: @page + 1)), icon: "arrow-right", variant: :secondary, size: :sm %><% end %></div>
    </div>
  <% end %>
<% end %>
