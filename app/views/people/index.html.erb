<% content_for :title, "People" %>
<div class="flex items-end justify-between gap-8 pb-6 pt-8">
  <div class="flex flex-col gap-3">
    <div class="flex items-center gap-4">
      <%= lc_heading "People", level: 1, size: :page %>
    </div>
    <%= lc_text "Everyone you have followed, been followed by, or talked with. Open a person for the full timeline.", tone: :muted %>
  </div>
  <%= lc_button_link_to "Add a person", new_person_path, icon: "plus" %>
</div>

<%= form_with url: people_path, method: :get, class: "mb-4 flex flex-wrap items-center gap-2", data: { controller: "auto-submit", turbo_action: "replace" } do %>
  <% if params[:sort].present? %><%= hidden_field_tag :sort, params[:sort] %><% end %>
  <%= lc_input name: "q", value: params[:q], type: :search, placeholder: "Search names, handles, bios, notes…", aria: { label: "Search people" }, class: "w-80" %>
  <%= lc_select [["Any follow status", ""], ["Mutuals", "mutual"], ["You follow only", "following_only"], ["They follow only", "followers_only"], ["Lost followers", "lost"]], name: "follow", selected: params[:follow], aria: { label: "Follow status" }, data: { action: "auto-submit#submit" }, class: "w-auto" %>
  <%= lc_select [["Any replies", ""], *["Two-way", "You replied only", "They replied only", "No observed replies"].map { |state| [state, state] }], name: "state", selected: params[:state], aria: { label: "Reply state" }, data: { action: "auto-submit#submit" }, class: "w-auto" %>
  <%= lc_select [["Everyone", ""], ["Pinned", "pinned"], ["Kept", "kept"], ["With notes", "notes"]], name: "filter", selected: params[:filter], aria: { label: "Your markers" }, data: { action: "auto-submit#submit" }, class: "w-auto" %>
  <%= lc_button "Search", type: :submit, variant: :secondary, class: "sr-only" %>
  <% if people_filter_params.except(:sort).any? %><%= lc_button_link_to "Clear", people_path(people_filter_params.slice(:sort)), variant: :ghost, size: :sm, icon: "x-mark" %><% end %>
  <span class="ms-auto text-sm tabular-nums text-muted"><%= pluralize(@count, "person", plural: "people") %></span>
<% end %>
<% if params[:follow].present? && !@graph.complete? %><p class="mb-4"><%= lc_badge "Follow filters need complete follower and following checks", tone: :warning %></p><% end %>

<% if @people.empty? %>
  <%= lc_card class: "py-12" do %>
    <div class="flex flex-col items-center gap-4 text-center">
      <% if people_filter_params.except(:sort).any? %>
        <%= lc_heading "Nobody matches these filters.", level: 2, size: :section %>
        <%= lc_button_link_to "Clear filters", people_path, variant: :secondary, icon: "x-mark" %>
      <% else %>
        <%= lc_heading "Build your circle, one conversation at a time.", level: 2, size: :section %>
        <%= lc_text "People appear as supported replies and discovery results are imported. You can save someone yourself, too.", tone: :muted, class: "max-w-lg" %>
        <%= lc_button_link_to "Add your first person", new_person_path, variant: :secondary %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <%= lc_card padding: :none, class: "overflow-hidden" do %>
    <div class="overflow-x-auto" tabindex="0" role="region" aria-label="People">
      <%= lc_table class: "crm-people-table" do %>
        <caption class="sr-only">People, sorted by <%= { "name" => "name", "recent" => "most recent reply", "replies" => "most replies", "added" => "recently added", "followers" => "most followers" }.fetch(@sort) %></caption>
        <thead>
          <tr>
            <th scope="col"><%= people_sort_header "Person", "name" %></th>
            <th scope="col" class="text-end"><%= people_sort_header "Followers", "followers" %></th>
            <th scope="col">Follow</th>
            <th scope="col">Replies</th>
            <th scope="col" class="text-end"><%= people_sort_header "Count", "replies" %></th>
            <th scope="col"><%= people_sort_header "Last reply", "recent" %></th>
            <th scope="col">Notes · bio</th>
            <th scope="col"><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% @people.each do |person| %>
            <tr>
              <th scope="row" class="font-normal">
                <%= link_to person, class: "flex min-w-56 items-center gap-3" do %>
                  <%= person_avatar person %>
                  <span class="min-w-0">
                    <span class="flex items-baseline gap-1.5 font-semibold">
                      <span class="truncate"><%= person.name %></span>
                      <% if person.pin %><%= lc_icon "bookmark", variant: :solid, options: { class: "size-3.5 shrink-0 text-primary", "aria-label": "Pinned" } %><% end %>
                      <% if person.follow_protection %><span class="shrink-0 text-xs font-normal text-success" title="Protected from cleanup">· kept</span><% end %>
                    </span>
                    <span class="block text-xs text-muted">@<%= person.handle %></span>
                  </span>
                <% end %>
              </th>
              <td class="whitespace-nowrap text-end text-sm tabular-nums"><%= compact_count person.followers_count %></td>
              <td class="whitespace-nowrap"><%= relationship_badge person.follow_state(@graph) %></td>
              <td class="whitespace-nowrap"><%= relationship_badge person.reply_state %></td>
              <td class="whitespace-nowrap text-end text-xs tabular-nums text-muted" title="Replies from you · replies from them">
                <% if person.reply_events.any? %>
                  <span class="inline-flex items-center gap-0.5"><%= lc_icon "arrow-up-right", options: { class: "size-3", "aria-hidden": true } %><%= person.outgoing_count %></span>
                  <span class="ms-2 inline-flex items-center gap-0.5"><%= lc_icon "arrow-down-left", options: { class: "size-3", "aria-hidden": true } %><%= person.incoming_count %></span>
                <% else %>—<% end %>
              </td>
              <td class="whitespace-nowrap text-sm"><%= relative_day person.last_interaction_at %></td>
              <td class="max-w-md text-sm">
                <% if person.notes.present? %>
                  <span class="line-clamp-2"><%= person.notes %></span>
                <% else %>
                  <span class="line-clamp-2 text-muted"><%= person.description.presence || "—" %></span>
                <% end %>
              </td>
              <td class="text-end"><%= link_to person, class: "inline-flex text-muted hover:text-primary", aria: { label: "Open #{person.name}" } do %><%= lc_icon "chevron-right", options: { class: "size-4" } %><% end %></td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </div>
  <% end %>
<% end %>

<div class="mt-4 flex items-center justify-between gap-4">
  <div><% if @page > 1 %><%= lc_button_link_to "Previous", people_path(people_filter_params(page: @page - 1)), variant: :secondary, size: :sm, icon: "arrow-left" %><% end %></div>
  <p class="text-sm text-muted tabular-nums">
    <% if @count.positive? %><%= (@page - 1) * PeopleController::PER_PAGE + 1 %>–<%= [@page * PeopleController::PER_PAGE, @count].min %> of <% end %><%= pluralize(@count, "person", plural: "people") %>
    <% if @graph.following || @graph.followers %> · follow status from saved checks: following <%= @graph.following&.observed_at&.strftime("%-d %b, %H:%M") || "unknown" %>, followers <%= @graph.followers&.observed_at&.strftime("%-d %b, %H:%M") || "unknown" %><% end %>
  </p>
  <div><% if @page * PeopleController::PER_PAGE < @count %><%= lc_button_link_to "Next", people_path(people_filter_params(page: @page + 1)), variant: :secondary, size: :sm, icon: "arrow-right", icon_position: :end %><% end %></div>
</div>
