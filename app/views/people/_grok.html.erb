<% recap = person.grok_proposals.latest_recap %>
<% pending = person.grok_proposals.pending.order(:created_at) %>
<% if recap || pending.any? %>
  <%= lc_card padding: :sm do %>
    <div class="flex flex-col gap-content">
      <h2 class="flex items-center gap-tight text-small font-semibold text-grok"><%= lc_icon "sparkles", options: { class: "size-4", "aria-hidden": true } %>Grok</h2>
      <% if recap %>
        <div>
          <p class="whitespace-pre-line text-small"><%= recap.payload["summary"] %></p>
          <p class="mt-tight text-caption text-muted-foreground" title="Grok research, not collected evidence">Accepted <%= relative_day recap.reviewed_at %></p>
        </div>
      <% end %>
      <% pending.each do |proposal| %>
        <div class="flex flex-col gap-related rounded-2xl bg-tile p-content text-small">
          <p class="font-semibold"><%= { "recap" => "Proposed recap", "tags" => "Proposed tags", "profile" => "Proposed profile facts" }.fetch(proposal.kind) %></p>
          <% if proposal.kind == "tags" %>
            <div class="flex flex-wrap gap-1.5"><% proposal.payload["tags"].each do |name| %><%= tag_chip name %><% end %></div>
            <% if proposal.payload["reason"] %><p class="text-caption text-muted-foreground"><%= proposal.payload["reason"] %></p><% end %>
          <% elsif proposal.kind == "recap" %>
            <p class="whitespace-pre-line"><%= proposal.payload["summary"] %></p>
            <% Array(proposal.payload["evidence_urls"]).each do |url| %>
              <% unless demo? %><%= link_to url.truncate(48), url, target: "_blank", rel: "noopener noreferrer", class: "text-caption text-primary hover:underline" %><% end %>
            <% end %>
          <% else %>
            <dl class="grid grid-cols-[auto_1fr] gap-x-heading gap-y-tight">
              <% proposal.payload.except("observed_at").each do |key, value| %>
                <dt class="text-muted-foreground"><%= key.humanize %></dt>
                <dd><%= value %><% if person[key].present? %> <span class="text-caption text-muted-foreground">(you already have a value; it stays)</span><% end %></dd>
              <% end %>
            </dl>
            <p class="text-caption text-muted-foreground">Accepting fills only empty fields. X-collected data and your edits always win.</p>
          <% end %>
          <div class="flex gap-related">
            <%= lc_button_to "Accept", grok_proposal_path(proposal), method: :patch, params: { decision: "accept" }, variant: :secondary, size: :sm, icon: "check" %>
            <%= lc_button_to "Dismiss", grok_proposal_path(proposal), method: :patch, params: { decision: "dismiss" }, variant: :ghost, size: :sm, icon: "x-mark" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
