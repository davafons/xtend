<% content_for :title, "Add a person" %>
<h1 class="sr-only">Add a person</h1>
<div class="max-w-xl">
  <%= lc_card do %>
    <%= form_with model: @person, class: "flex flex-col gap-inset" do %>
      <% if @person.errors.any? %>
        <%= lc_alert @person.errors.full_messages.to_sentence, tone: :destructive %>
      <% end %>
      <%= lc_field label: "Name", id: "person-name" do |field| %>
        <%= lc_input name: "person[name]", value: @person.name, required: true, **field %>
      <% end %>
      <%= lc_field label: "X handle", id: "person-handle", hint: "Without the @. A handle alone does not verify their X identity." do |field| %>
        <%= lc_input name: "person[handle]", value: @person.handle, required: true, **field %>
      <% end %>
      <%= lc_field label: "Notes", id: "person-notes" do |field| %>
        <%= lc_textarea @person.notes, name: "person[notes]", rows: 4, **field %>
      <% end %>
      <div class="flex items-center gap-heading">
        <%= lc_button "Save person", type: :submit %>
        <%= lc_button_link_to "Cancel", people_path, variant: :ghost %>
      </div>
    <% end %>
  <% end %>
</div>
