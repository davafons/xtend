<% if entry.post? %>
  <% social = entry.title unless entry.title == "Posted" %>
  <% if social %>
    <p class="mb-1 grid grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-x-3 text-[0.8125rem] font-bold <%= ApplicationHelper::MEANING_TEXT.fetch(entry.tone) %>">
      <span class="flex justify-end"><%= lc_icon entry.icon, options: { class: "size-4", "aria-hidden": true } %></span><span><%= social %></span>
    </p>
  <% end %>
  <% if entry.parent %>
    <% parent_url = "https://x.com/i/status/#{entry.parent.x_id}" unless entry.url.nil? %>
    <%= render "people/tweet", author: entry.parent.author, person: person, owner_handle: owner_handle, body: entry.parent.body,
      at: nil, url: parent_url, marks: timeline.marks[entry.parent.x_id], thread: true, analytics: timeline.analytics_for(entry.parent.x_id), source: timeline.sources[entry.parent.x_id], **timeline.counts_for(entry.parent.x_id) %>
  <% end %>
  <%= render "people/tweet", author: entry.author, person: person, owner_handle: owner_handle, body: entry.body, at: entry.at,
    url: entry.url, marks: timeline.marks[entry.x_id], detail: entry.detail, analytics: timeline.analytics_for(entry.x_id), source: timeline.sources[entry.x_id], **timeline.counts_for(entry.x_id) %>
<% else %>
  <div class="grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-center gap-x-3 text-[0.9375rem] leading-5">
    <span class="flex size-10 items-center justify-center rounded-full <%= ApplicationHelper::MEANING_CLASSES.fetch(entry.tone) %>"><%= lc_icon entry.icon, options: { class: "size-5", "aria-hidden": true } %></span>
    <div class="min-w-0">
      <p class="flex min-w-0 items-center gap-1">
        <span class="truncate"><%= entry.title %></span>
        <span class="shrink-0 text-muted-foreground"><span aria-hidden="true">|</span> <%= lc_time entry.at %></span>
      </p>
      <% if entry.detail %><p class="truncate text-[0.8125rem] text-muted-foreground"><%= entry.detail %></p><% end %>
    </div>
    <% if entry.url && !demo? %><%= lc_icon_button_link_to "Open on X", entry.url, icon: "arrow-up-right", size: :sm, target: "_blank", rel: "noopener noreferrer", title: "Open on X" %><% end %>
  </div>
<% end %>
