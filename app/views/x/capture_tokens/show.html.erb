<% content_for :title, "Capture token" %>
<h1 class="sr-only">Your capture token</h1>
<div class="<%= lc_stack_class(gap: :section, extra: "max-w-3xl mx-auto w-full") %>">
  <%= lc_alert "Copy it now. It's shown only once; creating another token revokes this one.", tone: :warning %>
  <%= lc_list_section "Paste both into the extension's options", footnote: "The token can only send captured X data to this workspace. Revoke it on X data if it leaks." do %>
    <div class="<%= lc_stack_class(gap: :content) %>">
      <%= lc_code_block @token, id: "capture-token", title: "Token" %>
      <%= lc_code_block request.base_url, id: "capture-url", title: "Xtend address" %>
    </div>
  <% end %>
  <div><%= lc_button_link_to "Done", x_sources_path(anchor: "capture"), variant: :secondary, size: :sm, icon: "arrow-left", aria: { label: "Back to X data" } %></div>
</div>
