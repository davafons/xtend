<% value = ->(text) { tag.span(text, class: "text-small tabular-nums text-muted-foreground") } %>
<div id="billing" class="<%= lc_stack_class(gap: :section, extra: "max-w-3xl scroll-mt-section") %>">
  <div class="flex items-end justify-between gap-content px-content sm:px-inset">
    <p class="text-3xl font-semibold tabular-nums"><%= number_to_currency(@workspace.monthly_budget_cents / 100.0) %><span class="text-body font-normal text-muted-foreground"> / billing cycle</span></p>
    <%= lc_button_link_to "X console", "https://console.x.com/", target: "_blank", rel: "noopener noreferrer", variant: :ghost, size: :sm, icon: "arrow-up-right", aria: { label: "Open X billing" } %>
  </div>

  <% if @cycle %>
    <% uncertain = X::Read.where(status: "uncertain").count %>
    <% if @cycle.remaining_micros <= @cycle.allowance_micros / 5 %><%= lc_alert "Less than 20% of the local allowance remains. Prefer cached context and relationship updates.", tone: :warning %><% end %>
    <% if uncertain.positive? %><%= lc_alert "#{uncertain} request reservations have uncertain outcomes. Their full cost remains held.", tone: :warning %><% end %>
    <%= lc_list_section "This cycle", footnote: "X enforces the cap account-wide, so other apps' usage is unknown. Update the observation at least daily before collecting." do %>
      <%= lc_list_group do %>
        <%= lc_list_row "Observed account spend", icon: "eye", subtitle: "Checked #{time_ago_in_words(@cycle.observed_at)} ago" do %><%= value.(microdollars(@cycle.provider_spend_micros)) %><% end %>
        <%= lc_list_row "Later estimates and holds", icon: "clock" do %><%= value.(microdollars(@cycle.pending_micros)) %><% end %>
        <%= lc_list_row "Local remaining allowance", icon: "wallet" do %><%= value.(microdollars(@cycle.remaining_micros)) %><% end %>
        <%= lc_list_row "Pricing basis", icon: "receipt-percent" do %><%= value.(@cycle.owned_pricing? ? "Recorded owned-read evidence" : "Standard rates") %><% end %>
        <%= lc_list_row "Cycle", icon: "calendar" do %><%= value.("#{@cycle.starts_on.strftime("%-d %b")} – #{@cycle.ends_on.strftime("%-d %b %Y")}") %><% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= lc_alert "No billing cycle recorded yet. X API reads stay locked until you record one below.", tone: :warning %>
  <% end %>

  <%= lc_list_section "Record console observation", footnote: "Spend from the X console, not credit balance: 73 cents means $0.73. The end date is exclusive. This app cannot verify or change your X billing cap." do %>
    <%= form_with url: x_billing_cycles_path do %>
      <%= lc_list_group do %>
        <%= lc_list_field "Starts", icon: "calendar", id: "cycle-start" do %><%= lc_input type: :date, name: "cycle[starts_on]", value: @cycle&.starts_on, required: true, plain: true, id: "cycle-start" %><% end %>
        <%= lc_list_field "Ends", icon: "calendar-days", id: "cycle-end" do %><%= lc_input type: :date, name: "cycle[ends_on]", value: @cycle&.ends_on, required: true, plain: true, id: "cycle-end" %><% end %>
        <%= lc_list_field "Spend (cents)", icon: "banknotes", id: "cycle-spend" do %>
          <div class="flex items-center gap-related">
            <%= lc_input type: :number, name: "cycle[spend_cents]", min: 0, step: 1, required: true, plain: true, placeholder: "73", id: "cycle-spend" %>
            <%= lc_button "Record", type: :submit, variant: :secondary, size: :sm, disabled: demo?, aria: { label: "Record console observation" } %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= lc_list_section "Allowance", footnote: "A local limit. Saving it doesn't change the cap at X." do %>
    <% if @workspace.errors.any? %><%= lc_alert @workspace.errors.full_messages.to_sentence, tone: :destructive %><% end %>
    <%= form_with model: @workspace, url: settings_path do %>
      <%= lc_list_group do %>
        <%= lc_list_field "Cents", icon: "wallet", id: "workspace-monthly-budget-cents" do %>
          <div class="flex items-center gap-related">
            <%= lc_input name: "workspace[monthly_budget_cents]", value: @workspace.monthly_budget_cents_before_type_cast, type: :number, min: 0, max: 100000, step: 1, required: true, plain: true, id: "workspace-monthly-budget-cents" %>
            <%= lc_button "Save", type: :submit, size: :sm, variant: :secondary, aria: { label: "Save allowance" } %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if @cycle %>
    <%= lc_list_section "Owned-read pricing", footnote: "Only after the console or billing evidence confirms owned rates for this developer app. A successful sign-in alone isn't enough." do %>
      <%= form_with url: x_billing_cycle_path(@cycle), method: :patch do %>
        <%= lc_list_group do %>
          <%= lc_list_field "Evidence", icon: "document-text", id: "pricing-evidence" do %><%= lc_textarea @cycle.pricing_evidence, name: "pricing_evidence", rows: 2, required: true, maxlength: 1000, id: "pricing-evidence" %><% end %>
          <%= lc_list_row do %>
            <div class="flex items-center justify-between gap-content">
              <label class="flex items-center gap-related text-small"><input type="checkbox" name="owned_confirmed" value="1" required> I checked owned-read pricing for the current app and owner.</label>
              <%= lc_button "Record", type: :submit, variant: :secondary, size: :sm, disabled: demo?, aria: { label: "Record pricing evidence" } %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <% unless @workspace.collection_trial_completed_at %>
      <%= lc_list_section "First-collection trial", footnote: "Also limited by the cycle balance." do %>
        <%= lc_list_group do %>
          <%= lc_list_row "Trial remaining", icon: "beaker" do %>
            <%= value.(microdollars(X::BillingCycle.trial_remaining_micros)) %>
            <%= lc_button_to "Finish", x_billing_cycle_path(@cycle), method: :patch, params: {finish_trial: "1"}, variant: :secondary, size: :sm, disabled: demo?, aria: { label: "Finish reviewed collection trial" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
