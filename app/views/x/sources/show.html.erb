<% content_for :title, "X data" %>
<h1 class="sr-only">X data</h1>
<div class="grid grid-cols-2 items-start gap-section">
  <div class="<%= lc_stack_class(gap: :section) %>">
    <%= lc_list_section "What's saved", id: "health", footnote: "Reply history has limited coverage: an empty direction doesn't mean no replies ever happened." do %>
      <%= lc_list_group do %>
        <%= lc_list_row "Followers", icon: "user-group", subtitle: (@followers ? "#{@followers.person_ids.size} #{@followers.completed_at ? 'complete' : 'partial'} records · #{@followers.observed_at.strftime('%-d %b, %H:%M')} · #{@followers.source.humanize}" : "No complete snapshot collected") do %>
          <%= lc_badge @followers&.fresh? ? "Current" : "Unavailable", tone: @followers&.fresh? ? :success : :neutral %>
        <% end %>
        <%= lc_list_row "Following", icon: "user-plus", subtitle: (@following ? "#{@following.person_ids.size} #{@following.completed_at ? 'complete' : 'partial'} records · #{@following.observed_at.strftime('%-d %b, %H:%M')} · #{@following.source.humanize}" : "No complete snapshot collected") do %>
          <%= lc_badge @following&.completed_at ? "Snapshot available" : "Incomplete" %>
        <% end %>
        <%= lc_list_row "Follower changes and timing", icon: "chart-bar", href: follower_history_path do %>
          <%= lc_icon "chevron-right", options: { class: "size-4 text-muted-foreground", "aria-hidden": true } %>
        <% end %>
        <%= lc_list_row "Reply history", icon: "chat-bubble-left-right", subtitle: "#{ReplyEvent.count} supported events" %>
        <%= lc_list_row "Private messages", icon: "envelope", subtitle: ((since = DirectMessage.covered_since) ? "#{pluralize(DirectMessage.count, "one-to-one message")} since #{since.strftime("%-d %b %Y")} · sender and time only, never text, and never sent to Grok" : "Not collected · never sent to Grok") %>
      <% end %>
    <% end %>
    <%= render "capture" %>
    <%= lc_list_section "Import your X archive", id: "archive", class: "scroll-mt-section", footnote: "Must be the archive of the connected account. Re-importing a newer archive only adds messages not already saved. Posts, likes, and follows in the archive aren't imported; X API collection covers them." do %>
      <%= lc_card do %>
        <%= form_with url: x_archive_imports_path, multipart: true, class: lc_stack_class(gap: :content) do %>
          <%= lc_text "Upload the .zip X sent you to fill in your full DM history, including encrypted chats the API can't see. Only the manifest, account, and DM files are opened. For one-to-one conversations it keeps who sent each message and when; message text is never stored.", size: :small, tone: :muted %>
          <% if (last_import = X::ArchiveImport.order(:created_at).last) %>
            <%= lc_text "Last import #{relative_day last_import.created_at}: archive generated #{last_import.generated_at.strftime("%-d %b %Y")} · #{pluralize(last_import.direct_messages_count, "new DM")}#{" · partial archive, so coverage isn't claimed" if last_import.partial}", size: :small %>
          <% end %>
          <%= lc_field label: "X archive · .zip", id: "archive-file" do |field| %>
            <%= tag.input type: :file, name: "file", accept: "application/zip,.zip", required: true, class: "text-small", **field %>
          <% end %>
          <div><%= lc_button "Import DM history", type: :submit, variant: :secondary, size: :sm, icon: "arrow-up-tray" %></div>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%= render "collection" %>
</div>
