<% connection = X::Connection.current %>
<%= lc_list_section "X account", id: "x-account", footnote: "Read-only: no posting, following, liking, or sending DMs. Register the callback URL exactly in the X developer console. Each sign-in costs one user read, recorded on Spending. Disconnecting removes saved tokens; revoke the app in X settings to remove X's authorization." do %>
  <% if X::Config.configured? && X::Config.callback_origin != request.base_url %>
    <%= lc_alert "Open the app at #{X::Config.callback_origin} to sign in, so the callback uses the same browser session.", tone: :warning %>
  <% end %>
  <%= lc_list_group do %>
    <%= lc_list_row (connection ? "@#{connection.username}" : "Not connected"), icon: "user-circle", subtitle: (connection ? "Identity checked #{time_ago_in_words(connection.identity_checked_at)} ago" : "Your X credentials were removed. Sign in with X again to reconnect read-only access.") do %>
      <%= lc_badge connection ? "Credentials saved" : "Not connected", tone: connection ? :success : :warning %>
      <% if X::Config.configured? %>
        <% if connection %>
          <%= lc_icon_button_to "Check connection", x_connection_path, method: :patch, icon: "arrow-path", size: :sm, title: "Check connection" %>
          <%= lc_icon_button_to "Disconnect locally", x_connection_path, method: :delete, icon: "link-slash", size: :sm, tone: :destructive, title: "Disconnect locally" %>
        <% else %>
          <%= lc_button_to "Sign in with X again", x_connection_path, variant: :primary, size: :sm, disabled: demo?, data: { turbo: false } %>
        <% end %>
      <% end %>
    <% end %>
    <% if connection %>
      <%= lc_list_row "Granted", icon: "shield-check", subtitle: connection.granted_scopes.split.to_sentence %>
    <% end %>
    <% if X::Config.configured? %>
      <%= lc_list_row "Callback URL", icon: "link", subtitle: tag.span(X::Config.redirect_uri, class: "font-mono") do %>
        <%= lc_copy_button value: X::Config.redirect_uri, icon_only: true, variant: :ghost, size: :sm, aria: { label: "Copy callback URL" } %>
      <% end %>
    <% else %>
      <%= lc_list_row "X app not configured", icon: "exclamation-triangle", subtitle: "Set X_CLIENT_ID, X_CLIENT_SECRET, and X_REDIRECT_URI in the environment, or x.client_id, x.client_secret, and x.redirect_uri in Rails credentials." %>
    <% end %>
  <% end %>
<% end %>
