<div class="flex flex-col gap-content">
  <div class="flex items-start justify-between gap-content">
    <div>
      <p class="font-semibold">Your X account</p>
      <% if X::Connection.current %>
        <p class="mt-related text-small text-muted-foreground">Connected as @<%= X::Connection.current.username %>. Identity checked <%= time_ago_in_words(X::Connection.current.identity_checked_at) %> ago.</p>
      <% else %>
        <p class="mt-related text-small text-muted-foreground">Your X credentials were removed. Sign in with X again to reconnect read-only access.</p>
      <% end %>
    </div>
    <%= lc_badge X::Connection.current ? "Credentials saved" : "Not connected", tone: X::Connection.current ? :success : :warning %>
  </div>
  <% if X::Config.configured? %>
    <p class="text-small text-muted-foreground">Read-only access to posts, profiles, followers, following, likes, bookmarks, and DMs, plus refresh access. <% if X::Connection.current %>Granted now: <%= X::Connection.current.granted_scopes.split.to_sentence %>. <% end %>No posting, following, liking, or DM-sending permissions.</p>
    <% if X::Config.callback_origin != request.base_url %>
      <%= lc_alert "Open the app at #{X::Config.callback_origin} to sign in, so the callback uses the same browser session.", tone: :warning %>
    <% end %>
    <div class="flex flex-wrap gap-related">
      <% if X::Connection.current %>
        <%= lc_button_to "Check connection", x_connection_path, method: :patch, variant: :secondary, size: :sm, icon: "arrow-path" %>
        <%= lc_button_to "Disconnect locally", x_connection_path, method: :delete, variant: :ghost, size: :sm, icon: "link-slash" %>
      <% else %>
        <%= lc_button_to "Sign in with X again", x_connection_path, variant: :primary, size: :sm, icon: "link", disabled: demo?, data: { turbo: false } %>
      <% end %>
    </div>
  <% else %>
    <%= lc_text "The X app isn't configured. Set X_CLIENT_ID, X_CLIENT_SECRET, and X_REDIRECT_URI in the environment, or x.client_id, x.client_secret, and x.redirect_uri in Rails credentials.", size: :small, tone: :muted %>
  <% end %>
  <div class="rounded-2xl bg-tile p-content">
    <p class="text-small font-semibold">Exact callback URL</p>
    <p class="mt-related break-all text-small"><%= X::Config.redirect_uri.presence || "Not configured" %></p>
    <p class="mt-related text-caption text-muted-foreground">The callback path is <code>/x/connection/callback</code>. Register the complete configured URL exactly in the X developer console. The configured origin must match the browser session used to connect.</p>
  </div>
  <p class="text-caption text-muted-foreground">Each sign-in checks only your account identity, which costs one API user read and is recorded on Spending. It doesn't collect tweets or follows or start recurring jobs. Disconnecting removes the saved tokens; revoke the app in X settings to remove X's authorization.</p>
</div>
