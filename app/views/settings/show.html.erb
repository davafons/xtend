<% content_for :title, "Settings" %>
<h1 class="sr-only">Settings</h1>
<div class="grid grid-cols-2 items-start gap-section">
  <div class="flex flex-col gap-section">
    <%= lc_section title: "Your workspace" do %>
      <%= lc_card do %>
        <%= form_with model: @workspace, url: settings_path, class: "flex flex-col gap-inset" do %>
          <%= lc_field label: "Workspace name", id: "workspace-name" do |field| %>
            <%= lc_input name: "workspace[name]", value: @workspace.name, required: true, **field %>
          <% end %>
          <%= lc_field label: "What you build and care about", id: "workspace-interests", hint: "One topic per line. These are editable interests, not a public biography." do |field| %>
            <%= lc_textarea @workspace.builder_interests, name: "workspace[builder_interests]", rows: 6, **field %>
          <% end %>
          <div>
            <%= lc_button "Save interests", type: :submit, size: :sm, icon: "adjustments-horizontal" %>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <%= lc_section title: "Posting reminders" do %>
      <%= lc_card do %>
        <%= form_with model: @workspace, url: settings_path, class: "flex flex-col gap-inset" do %>
          <%= lc_field label: "Posting times and strategy", id: "workspace-posting-notes", hint: "Keep your preferred times, time zone, and audience here as a reminder." do |field| %>
            <%= lc_textarea @workspace.posting_notes, name: "workspace[posting_notes]", rows: 14, **field %>
          <% end %>
          <div>
            <%= lc_button "Save posting reminders", type: :submit, size: :sm, icon: "bookmark" %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="flex flex-col gap-section">
    <%= lc_section title: "X account" do %>
      <%= lc_card do %><%= render "x_connection" %><% end %>
    <% end %>
  </div>
</div>
