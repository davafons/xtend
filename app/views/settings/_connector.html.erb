<% workspace = Workspace.current %>
<section id="connector" class="flex flex-col gap-4 scroll-mt-8">
  <%= lc_heading "Grok Bot connector (MCP)", level: 2, size: :section %>
  <%= lc_card do %>
    <div class="flex flex-col gap-5">
      <%= lc_text "An MCP endpoint that lets an AI client read your CRM context and stage reply candidates, profile facts, and recaps for your review. It cannot post, follow, message, or start paid X reads.", tone: :muted %>
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-semibold">Endpoint</p>
          <p class="mt-2 break-all font-mono text-sm"><%= mcp_url %></p>
        </div>
        <%= lc_badge workspace.mcp_token_digest ? "Token active" : "No token", tone: workspace.mcp_token_digest ? :success : :neutral %>
      </div>
      <% if workspace.mcp_token_digest %>
        <p class="text-sm text-muted">Created <%= relative_day workspace.mcp_token_created_at %> · <%= workspace.mcp_token_used_at ? "last used #{time_ago_in_words(workspace.mcp_token_used_at)} ago" : "not used yet" %></p>
        <div class="flex flex-wrap gap-2">
          <%= lc_button_to "Replace token", mcp_token_path, variant: :secondary, size: :sm, icon: "arrow-path" %>
          <%= lc_button_to "Revoke token", mcp_token_path, method: :delete, variant: :ghost, size: :sm, icon: "no-symbol" %>
        </div>
      <% else %>
        <div><%= lc_button_to "Create connector token", mcp_token_path, variant: :secondary, size: :sm, icon: "key" %></div>
      <% end %>
      <div class="flex flex-col gap-3 border-t border-border pt-5">
        <p class="text-sm font-semibold">Shared with the connector</p>
        <p class="text-sm text-muted">Always: interests, people, public profiles, follow and reply states, pins, keeps, collected public posts, likes, and bookmarks.</p>
        <% [[:mcp_share_notes, "Your private notes"], [:mcp_share_dms, "DM metadata (who and when, never text)"]].each do |field, label| %>
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm"><%= label %> · <strong><%= workspace.public_send(field) ? "shared" : "not shared" %></strong></span>
            <%= lc_button_to workspace.public_send(field) ? "Stop sharing" : "Share", settings_path, method: :patch, params: { "workspace[#{field}]" => !workspace.public_send(field) }, variant: :ghost, size: :sm %>
          </div>
        <% end %>
      </div>
      <%= lc_alert "Grok Bot runs in xAI's cloud and can't reach this local app yet. Connecting it needs a separately approved network bridge. Until then, use the paste option under Find conversations with Grok, or test the endpoint with a local MCP client.", tone: :neutral %>
    </div>
  <% end %>
</section>
