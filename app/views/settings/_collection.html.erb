<section id="collection" class="flex flex-col gap-4 scroll-mt-8">
  <%= lc_heading "Collect a small sample", level: 2, size: :section %>
  <%= lc_card do %>
    <div class="flex flex-col gap-5">
      <%= lc_text "Each action reads one bounded page. Start with the four samples below; their combined standard-rate maximum is $2.10. A continuation always needs another click.", tone: :muted %>
      <% unless @cycle %>
        <%= lc_alert "Record the current billing cycle and account spend below before reading X.", tone: :warning %>
      <% end %>
      <div class="grid grid-cols-2 gap-3">
        <% [["followers", "Sample followers", "$1.00 · up to 100"], ["following", "Sample following", "$1.00 · up to 100"], ["own_posts", "Sample your posts", "$0.05 · up to 10"], ["mentions", "Sample mentions", "$0.05 · up to 10"]].each do |dataset, label, cost| %>
          <div class="flex flex-col gap-2">
            <%= lc_button_to label, x_sync_runs_path, params: {dataset: dataset, request_key: SecureRandom.uuid}, variant: :secondary, size: :sm, icon: {"followers" => "user-group", "following" => "user-plus", "own_posts" => "document-text", "mentions" => "at-symbol"}.fetch(dataset), disabled: demo? || !@cycle || !XConnection.current %>
            <p class="text-xs text-muted"><%= cost %> at standard rates</p>
          </div>
        <% end %>
      </div>
      <div class="flex flex-col gap-2">
        <%= lc_button_to "Refresh follower baseline", x_sync_runs_path, params: {dataset: "followers", mode: "refresh", request_key: SecureRandom.uuid}, variant: :secondary, size: :sm, icon: "arrow-path", disabled: demo? || !@cycle || !XConnection.current %>
        <p class="text-xs text-muted">Up to 200 followers per page. $0.20 maximum with recorded owned pricing, $2.00 at standard rates. One completed refresh also checks for follower losses.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <% ["own_posts", "mentions"].each do |dataset| %>
          <%= lc_button_to "Refresh #{dataset == 'own_posts' ? 'sent replies' : 'incoming activity'}", x_sync_runs_path, params: {dataset: dataset, mode: "refresh", request_key: SecureRandom.uuid}, variant: :ghost, size: :sm, disabled: demo? || !@cycle || !XConnection.current %>
        <% end %>
      </div>
      <div class="flex flex-col gap-3 border-t border-border pt-5">
        <p class="text-sm font-semibold">Private interactions</p>
        <% connection = XConnection.current %>
        <% missing = XConfig::DATASET_SCOPES.values.reject { |scope| connection&.granted?(scope) } %>
        <% if connection && missing.any? %>
          <%= lc_alert "Reconnect X to grant #{missing.to_sentence}. Your existing data is kept.", tone: :warning %>
        <% end %>
        <div class="grid grid-cols-3 gap-3">
          <% [["liked_posts", "Collect your likes", "heart", "Up to 100 per page · $0.10 owned, $0.50 standard"],
              ["bookmarks", "Collect bookmarks", "bookmark", "Up to 100 per page · $0.10 owned, $0.50 standard"],
              ["dm_events", "Collect DM activity", "envelope", "Up to 20 per page · $0.20, no owned rate"]].each do |dataset, label, icon, cost| %>
            <div class="flex flex-col gap-2">
              <%= lc_button_to label, x_sync_runs_path, params: {dataset: dataset, request_key: SecureRandom.uuid}, variant: :secondary, size: :sm, icon: icon, disabled: demo? || !@cycle || !connection&.granted?(XConfig::DATASET_SCOPES.fetch(dataset)) %>
              <p class="text-xs text-muted"><%= cost %></p>
            </div>
          <% end %>
        </div>
        <%= lc_text "The first run reads from the newest item backwards; later runs stop once they reach items already saved. X doesn't report when you liked or bookmarked something, so the post date (or the previous check) is the earliest possible time. DMs keep only who sent each one-to-one message and when, never the text, and X serves only the last 30 days.", size: :small, tone: :muted %>
      </div>
      <%= lc_text "Replies update only after their author and parent evidence can be resolved. Old history enriches people without increasing today's outreach. Collection ends 15 seconds before each check, so a just-sent reply may need a later refresh.", size: :small, tone: :muted %>
      <% unknown_users = XSyncRun.unresolved_user_ids %>
      <% unknown_parents = XSyncRun.unresolved_parent_ids %>
      <% if unknown_users.any? || unknown_parents.any? %>
        <div class="flex flex-col gap-3">
          <p class="text-sm font-semibold">Resolve missing context</p>
          <p class="text-xs text-muted"><%= unknown_users.size %> unresolved people · <%= unknown_parents.size %> missing parent posts. Each action resolves up to 20, within the remaining budget.</p>
          <div class="flex flex-wrap gap-2">
            <% if unknown_users.any? %><%= lc_button_to "Resolve people", x_sync_runs_path, params: {dataset: "users", request_key: SecureRandom.uuid}, variant: :secondary, size: :sm, disabled: demo? || !@cycle %><% end %>
            <% if unknown_parents.any? %><%= lc_button_to "Resolve parents", x_sync_runs_path, params: {dataset: "posts", request_key: SecureRandom.uuid}, variant: :secondary, size: :sm, disabled: demo? || !@cycle %><% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <% if @runs.any? %>
    <%= lc_card do %>
      <div class="flex flex-col gap-5">
        <%= lc_heading "Recent collection", level: 3, size: :card %>
        <% @runs.each do |run| %>
          <div id="<%= dom_id(run) %>" data-request-key="<%= run.request_key %>" class="flex flex-col gap-2 border-b border-border pb-4 last:border-0 last:pb-0">
            <div class="flex items-start justify-between gap-3">
              <p class="text-sm font-semibold"><%= run.dataset.humanize %> · <%= run.mode.humanize %></p>
              <%= lc_badge run.status.humanize, tone: run.status == "completed" ? :success : :neutral %>
            </div>
            <p class="text-xs text-muted"><%= run.resource_count %> resources · <%= run.page_number %> pages · <%= run.created_at.strftime("%-d %b, %H:%M") %></p>
            <% if run.message.present? %><p class="text-xs text-muted"><%= run.message %></p><% end %>
            <% if run.status == "partial" || run.status == "ready" || (run.status == "paused" && run.page_number.zero?) || run.x_reads.where(status: "received").exists? %>
              <div><%= lc_button_to(run.status == "paused" ? "Retry this page" : "Read next page", x_sync_run_path(run), method: :patch, params: {page: run.page_number}, variant: :secondary, size: :sm, disabled: demo? || (run.retry_at && run.retry_at > Time.current)) %></div>
            <% elsif run.status == "fetching" %>
              <div><%= lc_button_to "Recover interrupted page", x_sync_run_path(run), method: :patch, params: {recover: "1"}, variant: :ghost, size: :sm, disabled: run.updated_at > 2.minutes.ago %></div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
