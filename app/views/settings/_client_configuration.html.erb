<% saved = XClientConfiguration.current&.values || {} %>
<%= lc_section title: "X developer app" do %>
  <%= lc_card do %>
    <div class="flex flex-col gap-5">
      <p class="text-sm text-muted">Save your own developer app configuration on this computer. It stays encrypted locally and is never included in context exports.</p>
      <%= lc_badge "Configuration source: #{XConfig.source.to_s.humanize}" %>
      <% if XConnection.current %>
        <%= lc_text "Disconnect X locally before changing client configuration. Your relationship data will stay in place.", size: :small, tone: :muted %>
      <% elsif demo? %>
        <%= lc_text "Configuration is disabled in the fictional demo workspace.", size: :small, tone: :muted %>
      <% else %>
        <% if %i[environment credentials].include?(XConfig.source) %>
          <%= lc_alert "#{XConfig.source.to_s.humanize} configuration takes precedence. A Client ID in that source selects all its configuration values; saved form values do not override it.", tone: :warning %>
        <% end %>
        <%= form_with url: x_client_configuration_path, method: :patch, class: "flex flex-col gap-4", data: { turbo: false } do %>
          <%= lc_field label: "OAuth Client ID", id: "x-client-id" do |field| %>
            <%= lc_input name: "x_client_configuration[client_id]", value: saved[:client_id], autocomplete: "off", required: true, **field %>
          <% end %>
          <%= lc_field label: "Client Secret", id: "x-client-secret", hint: saved[:client_secret].present? ? "A secret is saved. Leave blank to keep it for the same Client ID." : "Required for a confidential web app. Leave blank for a public client." do |field| %>
            <%= lc_input name: "x_client_configuration[client_secret]", type: :password, autocomplete: "new-password", **field %>
          <% end %>
          <% if saved[:client_secret].present? %>
            <label class="flex items-center gap-3 text-sm"><input type="checkbox" name="x_client_configuration[clear_client_secret]" value="1">Remove the saved secret</label>
          <% end %>
          <%= lc_field label: "Exact redirect URI", id: "x-redirect-uri", hint: "Must exactly match the callback registered with X. The provider must accept this URL." do |field| %>
            <%= lc_input name: "x_client_configuration[redirect_uri]", value: saved[:redirect_uri].presence || "#{request.base_url}#{XConfig::CALLBACK_PATH}", type: :url, required: true, **field %>
          <% end %>
          <div><%= lc_button "Save local configuration", type: :submit, size: :sm, icon: "lock-closed" %></div>
        <% end %>
      <% end %>
      <p class="text-xs text-muted">Precedence is environment, then Rails encrypted credentials, then this local form. A source is selected by its Client ID, so credentials from different apps are never mixed.</p>
    </div>
  <% end %>
<% end %>
