<%# A saved post in X's layout: author, text, a quoted post, and the counts the capture last saw. %>
<%# locals: (post:, timeline:) %>
<% person = timeline.people[post.author_x_id] %>
<% account = timeline.accounts[post.author_x_id] %>
<% owner = post.author_x_id == Current.workspace.owner_x_id %>
<% name = owner ? "You" : person&.name || account&.name || "Unknown account" %>
<%
  avatar =
    if owner then owner_avatar
    elsif person then link_to(person_avatar(person, ring: person.follow_state(timeline.follow_graph)), person, tabindex: -1, aria: { hidden: true })
    elsif account&.avatar_url && !demo? then lc_avatar(src: account.avatar_image_url, alt: "", referrerpolicy: "no-referrer", loading: "lazy")
    else lc_avatar(name.first(2).upcase)
    end
  context = if post.reply_to_x_id
    target = timeline.people[post.reply_to_x_id] || timeline.accounts[post.reply_to_x_id]
    safe_join([ "Replying to ", tag.span(post.reply_to_x_id == Current.workspace.owner_x_id ? "you" : target ? "@#{target.handle}" : "a post", class: "text-you") ])
  end
  quote = (quoted = timeline.quoted[post.quoted_x_id]) && begin
    author = timeline.people[quoted.author_x_id] || timeline.accounts[quoted.author_x_id]
    { name: author&.name, handle: author&.handle, body: CGI.unescapeHTML(quoted.body) }
  end
  seen = timeline.sightings[post.x_id].to_i
  note = [ ("Counts as of #{post.metrics_observed_at.strftime('%-d %b, %H:%M')}" if post.metrics_observed_at), ("seen #{seen} times" if seen > 1) ].compact.join(" | ").presence
%>
<%= render "shared/x_post", avatar: avatar, name: name, name_url: person, handle: owner ? X::Connection.current&.username : person&.handle || account&.handle,
  at: post.published_at, detail: note, context: context, body: CGI.unescapeHTML(post.body).then { |text| post.reply_to_x_id ? text.sub(/\A(@\w+\s+)+/, "") : text }, media_kinds: post.media_kinds.to_s.split(","), quote: quote,
  counts: { reply: post.reply_count, repost: post.repost_count, like: post.like_count, view: post.view_count, bookmark: post.bookmark_count },
  counts_note: note, url: "https://x.com/i/status/#{post.x_id}" %>
