<% content_for :title, "Replies to you" %>
<h1 class="sr-only">Replies to you</h1>
<div class="mx-auto flex w-full max-w-[37.5rem] flex-col">
  <div class="flex items-center justify-between gap-heading pb-content">
    <%= view_tabs "Period", InboxController::PERIODS.map { |days| [ "#{days} days", inbox_path(days: days), @days == days ] } %>
    <span class="text-small tabular-nums text-muted-foreground" title="Answered means you replied to it directly, or replied to them later in the same thread, as soon as the capture sees it."><%= @inbox.count %> unanswered</span>
  </div>

  <% if @inbox.items.empty? %>
    <%= empty_state "Nothing waiting on you.", "Every collected reply from the last #{@days} days has an answer or was set aside.", icon: "inbox" %>
  <% else %>
    <ul class="flex flex-col divide-y divide-border border-y border-border">
      <% @inbox.items.each do |item| %>
        <% person = item.person %>
        <% post = item.post %>
        <% state = person.reply_state %>
        <li class="py-3" id="<%= dom_id(item.event, :inbox) %>">
          <%= render "shared/x_post",
            avatar: link_to(person_avatar(person), person, tabindex: -1, aria: { hidden: true }),
            name: person.name, name_url: person, handle: person.handle, at: item.occurred_at,
            cue: tag.span(lc_icon(relationship_icon(state), options: { class: "size-4", "aria-hidden": true }) + tag.span(state, class: "sr-only"), class: "shrink-0 #{ApplicationHelper::MEANING_TEXT.fetch(state_meaning(state))}", title: state),
            body: post&.body&.sub(/\A(@\w+\s+)+/, ""),
            counts: post ? { reply: post.reply_count, repost: post.repost_count, like: post.like_count, view: post.view_count, bookmark: post.bookmark_count } : nil,
            marks: item.liked ? [ "like" ] : [], url: item.url,
            extra: lc_icon_button_to("Set aside the reply from #{person.name}", reply_event_dismissal_path(item.event), icon: "archive-box", size: :sm, title: "Set aside without answering") %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
