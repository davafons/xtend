<% content_for :title, "Replies to you" %>
<h1 class="sr-only">Replies to you</h1>
<div class="flex w-full flex-col gap-content">
  <div class="flex flex-wrap items-end gap-x-heading gap-y-related">
    <%= lc_tab_bar label: "Replies", fill: true, class: "flex-1" do |bar| %>
      <%= bar.link "Waiting", inbox_path(days: @days), current: !@follow_ups, count: @inbox.waiting_count, title: "Answered means you replied to it directly, or replied to them later in the same thread." %>
      <%= bar.link "Follow-ups", inbox_path(days: @days, show: "follow_ups"), current: @follow_ups, count: @inbox.follow_up_count, title: "They replied to your answer. Fine to leave these as the end of the exchange." %>
    <% end %>
    <%= view_tabs "Period", InboxController::PERIODS.map { |days| [ "#{days} days", inbox_path(days: days, show: (@follow_ups ? "follow_ups" : nil)), @days == days ] } %>
  </div>

  <% if @inbox.items.empty? %>
    <% if @follow_ups %>
      <%= lc_empty_state title: "No open follow-ups.", icon: "chat-bubble-left-right", card: true %>
    <% else %>
      <%= lc_empty_state title: "Nothing waiting on you.", text: "Every collected reply from the last #{@days} days has an answer or was set aside.", icon: "inbox", card: true %>
    <% end %>
  <% else %>
    <%= lc_card padding: :none, class: "overflow-hidden" do %>
      <ul class="flex flex-col divide-y divide-border">
        <% @inbox.items.each do |item| %>
          <% person = item.person %>
          <% post = item.post %>
          <% state = person.reply_state %>
          <li class="px-inset py-3" id="<%= dom_id(item.event, :inbox) %>">
            <%= render "shared/x_post",
              avatar: link_to(person_avatar(person), person, tabindex: -1, aria: { hidden: true }),
              name: person.name, name_url: person, handle: person.handle, at: item.occurred_at,
              cue: tag.span(lc_icon(relationship_icon(state), options: { class: "size-4", "aria-hidden": true }) + tag.span(state, class: "sr-only"), class: "shrink-0 #{ApplicationHelper::MEANING_TEXT.fetch(state_meaning(state))}", title: state),
              body: post&.body&.sub(/\A(@\w+\s+)+/, ""),
              counts: post ? { reply: post.reply_count, repost: post.repost_count, like: post.like_count, view: post.view_count, bookmark: post.bookmark_count } : nil,
              source: post, marks: item.liked ? [ "like" ] : [], url: item.url,
              extra: lc_icon_button_to("Set aside the reply from #{person.name}", reply_event_dismissal_path(item.event), icon: "archive-box", size: :sm, title: "Set aside without answering") %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
