# Copy to .env for Docker Compose. Never commit .env.
# Your public hostname, without https://
APP_HOSTS=xtend.example.com
# From your X developer app (docs/setup.md). The callback must match the app's Callback URI exactly.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://xtend.example.com/x/connection/callback
# Generate once with: docker compose run --rm xtend bin/rails secret
SECRET_KEY_BASE=
